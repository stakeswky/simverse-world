# Realism (world simulation). Production decision (ROADMAP §0「拟真开闸」):
# REALISM P0–P2 are ENABLED in production. The code default (config.py) stays
# False for a one-flag rollback; this example registers the production value.
# Per-tick metabolism/emotion knobs below are REAL-TIME and stay unchanged under
# the k=4 world clock (tick is still every 60 real seconds — see agent-T world
# clock design §6). Only per-world-day/week semantics (relation decay gate,
# weekend/festival via world_weekday) shift with k, and those are gate-driven.
REALISM_ENABLED=true
REALISM_PLAN_CONTINUITY_ENABLED=false   # staged rollout: sticky travel + per-slot interrupts
REALISM_SOCIAL_INTERRUPT_NEED_MAX=0.35
REALISM_SOCIAL_INTERRUPT_MAX_IMPORTANCE=4
REALISM_NOTABLE_EVENT_MAX_WORLD_MINUTES=60
REALISM_PLAN_CONTINUATION_MAX_STEPS=32
REALISM_MOVE_SPEED=8                    # P1: A* path tiles walked per tick
REALISM_RETRIEVAL_RELEVANCE_WEIGHT=0.45   # scored retrieval: cosine relevance weight
REALISM_RETRIEVAL_RECENCY_WEIGHT=0.30     # scored retrieval: recency weight
REALISM_RETRIEVAL_IMPORTANCE_WEIGHT=0.25  # scored retrieval: importance weight (three sum to 1.0)
REALISM_RECENCY_TAU_HOURS=72.0         # recency τ base; τ = this × (1 + importance)
# 候选池内的镇务保留位。0 = 逐字节旧行为（一个数同时表达「开没开」与「几个坑」）。
# 候选池是 `ORDER BY importance DESC LIMIT 30` —— 相关度那 0.45 是**截断之后**才
# 参与的，所以池底顶到 1.0 的居民（生产 jiang-lin/zhao-qiwen）永远收不到归一 0.99
# 的镇务结果记忆，差 0.01。保留位在池内给 civic:poll_result 留 N 个坑，
# **不扩池**：没填满的坑退还给个人臂，len(pool) 与改前逐字相同。
# 只收结果档（civic:poll_result:%），征询档与 world_event 不进专用道。
# fail-open 路径（cap<30，embedding 拿不到时）自动失效，见 memory/service.py。
REALISM_POOL_CIVIC_RESERVE=0
# 候选池内的 world_event 保留位（第二条道）。0 = 逐字节旧行为（只有 civic 道那一版）。
# 只收 metadata_json->>'tier' = 'substantive' 的 world_event 记忆 —— **不按 source
# 开道**：生产实测 source='world_event' 且带 raw_importance 的记忆 0/1380，公共臂
# top-41 全是 importance=0.5 的天气，按 source 开道 94% 抓到天气。
# 与 civic 道同构：道内 created_at DESC，没填满的坑退还给个人臂，fail-open（cap<30）
# 时两条道都不生效。建议开闸值 1（实质事件约 1.6 条/人/周，1 个坑 ≈「记得最近那件事」）。
# ⚠️ 与 REALISM_EVENT_MEMORY_TIERED 的关系：那条「分档抬 importance」的路已被本道
# **取代，不要开** —— 抬到 0.99 的实质事件会同时挤占个人臂（12 周饱和 day84 21/30）
# 又吃专用道坑位，双重占坑；专用道本身就保证**进候选池**，不需要靠抬 importance 去挤。
# ⚠️ 「保证进候选池」≠「保证被检索到」：池是 30 条，prompt 拿的是打分后的 top-10。
# 进池只是参赛资格，世界事件还要 cos 打赢第 10 名个人记忆才进得了 prompt（切题的
# 问句过得去、不切题的过不去——这是想要的行为）。核验开闸效果要走 retrieve_context
# 的返回值，查「进没进 top-30」会拿到假阳性。
REALISM_POOL_WORLD_EVENT_RESERVE=0
# 计划阶段 prompt 里「镇上的事」的条数上限。0 = 计划 prompt **逐字节**旧行为。
# 与上面两条候选池的道无关：计划阶段不走 retrieve_context（没有 query text），
# 它直接读同样那两条判据的最近 N 条（镇务结果档 / 实质世界事件），与「个人近况」
# 并列送进 plan prompt。个人近况那条 limit=20 与 importance>0.5 都不动。
# 建议开闸值 2（一条镇务 + 一条世界事件的量级）。不要用 1：结票当天那条新鲜镇务
# 记忆必然也在最近 20 条里，去重之后 1 个名额恰好被吃光，整段渲染成空。
REALISM_PLAN_PUBLIC_MEMORIES=0
REALISM_EVICT_IMPORTANCE_FLOOR=0.35    # soft-archive events below this importance
REALISM_EVICT_IDLE_DAYS=90             # ...and not accessed in this many days
REALISM_PROPOSAL_STUCK_MINUTES=10      # reclaim proposals stuck in `approved` longer than this
REALISM_MOOD_POSITIVE_VALENCE=0.15     # chat-outcome mood nudge (positive)
REALISM_MOOD_POSITIVE_AROUSAL=0.05
REALISM_MOOD_NEGATIVE_VALENCE=-0.2     # chat-outcome mood nudge (negative; higher arousal)
REALISM_MOOD_NEGATIVE_AROUSAL=0.1
REALISM_FLASHBULB_COEF=0.2             # importance += coef × |valence| × arousal
# Realism P1 (rule-based; still gated by REALISM_ENABLED)
REALISM_MOVE_RAIN=0.75
REALISM_MOVE_STORM=0.5
REALISM_MOVE_SNOW=0.6
REALISM_MOVE_AROUSAL_BOOST=1.2
REALISM_MOVE_AROUSAL_THRESHOLD=0.7
REALISM_WEATHER_SUNNY=1.0
REALISM_WEATHER_CLOUDY=0.95
REALISM_WEATHER_RAIN=0.7
REALISM_WEATHER_STORM=0.4
REALISM_WEATHER_SNOW=0.75
REALISM_SHELTER_PROB=0.6
REALISM_WEATHER_MOOD_RAIN_VALENCE=-0.02
REALISM_WEATHER_MOOD_RAIN_AROUSAL=-0.01
REALISM_WEATHER_MOOD_SUNNY_VALENCE=0.02
REALISM_WEEKEND_WAKE_DELAY=1
REALISM_WEEKEND_REST_BOOST=0.1
REALISM_FESTIVAL_SOCIAL_BOOST=0.2
REALISM_FESTIVAL_WEIGHT=3.0
REALISM_NEEDS_INITIAL=0.8
REALISM_NEEDS_CRITICAL=0.25
REALISM_ENERGY_AWAKE=-0.004
REALISM_ENERGY_WALKING=-0.006
REALISM_ENERGY_SLEEP=0.02
REALISM_SATIETY_DECAY=-0.0015  # 0804 重校准，推演见 config.py realism_satiety_decay 注释
REALISM_EAT_RESTORE=0.5
REALISM_SOCIAL_INTROVERT=-0.001
REALISM_SOCIAL_EXTRAVERT=-0.006
REALISM_SOCIAL_DEFAULT=-0.003
REALISM_SOCIAL_CHAT=0.4
REALISM_SOCIAL_GREET=0.1
REALISM_GOAL_ACHIEVED_VALENCE=0.4
REALISM_GOAL_ACHIEVED_AROUSAL=0.2
REALISM_GOAL_FAILED_VALENCE=-0.3
REALISM_GOAL_FAILED_AROUSAL=0.1
REALISM_GOSSIP_VICTIM_VALENCE=-0.1
REALISM_GOSSIP_VICTIM_AROUSAL=0.15
REALISM_DREAM_TONE_DELTA=0.1
REALISM_VALENCE_ACTIVITY_COEF=0.2
REALISM_CONTAGION_RATE=0.1
REALISM_IMPORTANCE_WINDOW=100
REALISM_SHIFT_PERCENTILE=0.95
REALISM_SHIFT_VALENCE_GATE=0.5
REALISM_PERSONALITY_PACING_ENABLED=false  # staged: world cooldown + real rolling safety budgets
REALISM_DRIFT_MIN_WORLD_HOURS=72

# Realism P2 (social structure) — three INDEPENDENT gates. Production decision
# (ROADMAP §0): all three ENABLED. Code default stays false for per-axis rollback;
# each is independent of REALISM_ENABLED and of each other (separate A/B if needed).
REALISM_RELATIONS_ENABLED=true
REALISM_INFO_GRADIENT_ENABLED=true
REALISM_CROWD_ENABLED=true
REALISM_GOSSIP_EVENT_LANE_ENABLED=false  # staged: reserve recent event_id rumors

# ── P1 地点能力声明（LOCATION_CAPABILITIES_ENABLED）────────────────────────────
# 关（默认）= 逐字节旧行为：RESEARCH 门比字面量 experiment_building，dining 走
# _DINING_LOCATIONS={cafe,tavern} 白名单，餐费按 cafe_host/tavern_hub 硬编码分账。
# 开 = 这三处改读地点自己的 capabilities 声明；声明已随代码落地（cafe/tavern/
# experiment_building/market_hall 四条静态条目），开闸不带任何数据变更。
# 与 REALISM_ENABLED 正交：EAT 门本来就在 realism 内层，本闸是内层再套一层。
# 开闸前先确认 tests/test_capability_action_gates.py 的等价用例在本机为绿。
LOCATION_CAPABILITIES_ENABLED=false

# ── P2 营生场所（DUTY_VENUE_ENABLED）──────────────────────────────────────────
# 关（默认）= 逐字节旧行为：邮差 WORK 时照旧投递、照旧写同一条记忆文本、metadata
# 不写、feed payload 不多键，decide 不产生任何导流。
# 开 = 两件事：
#   1 _work_postman 解析「投递现场」（站在提供 postal 能力的地点里），并给记忆写
#     metadata['duty'] = {key, at, delivered}——这是验收 M2 的唯一数据源，两个分支
#     都写（at 为 null 表示不在现场），否则比值的分母塌成分子；
#   2 decide 新增 _maybe_duty_venue 分支：营生有现场声明、今天还没上工、人不在现场
#     时，把这一 tick 定成 VISIT_DISTRICT 去现场（零 LLM）。
#
# 不改变的事（硬约束，也是回滚安全的全部根据）：胶囊的封存与投递**都不要求在邮局**。
# deliver_due_capsules 的 WHERE 不带任何 location 条件，nightly_cron 的无条件兜底原样
# 保留——邮局是「投递现场」不是「准入条件」。所以任何时刻把本闸翻回 false 都不会让
# 胶囊积压。护栏 SQL（恒为 0，违反即回滚）：
#   select count(*) from time_capsules
#    where status='sealed' and deliver_on < current_date - 1;
#
# 开闸硬前置（写死，别凭记忆）：
#   1 代码侧——P1 的 location_caps / capability_location_at / nearest_capability_location
#     必须已合入，且 CAPABILITIES 里登记了 postal（civic_grantable=true）。
#     注意：本闸**不**依赖 LOCATION_CAPABILITIES_ENABLED——location_capabilities 与
#     capability_location_at 都是不读闸的纯查询，那道闸只管 location_category 的能力
#     派生层与 RESEARCH/EAT 两个门。
#   2 数据侧——生产 dynamic_locations 里 post_office 那行的 data_json 必须已带上
#     capabilities={"postal":{}}。存量行是公投建的，没有这个键；回填是纯数据变更，
#     **必须独立批次**（迁移/数据变更与开闸不同车）。没回填就开闸不会出事，只是现场
#     分支恒不命中、M2 的 on_site 恒为 0，与今天等价。
DUTY_VENUE_ENABLED=false

# ── P2 剧院/舞台事件（STAGE_EVENT_ENABLED）─────────────────────────────────────
# 关（默认）= 逐字节旧行为：辩论生命周期一步不变、不建任何舞台世界事件、讲师的
# 公开课仍然是 type="news"。
# 开 = 两件事：
#   1 辩论开票的同一刻，在声明了 stage 能力的地点挂一条 type="script" 的 WorldEvent
#     （ends_at = 投票窗口 DEBATE_VOTE_WINDOW_MIN）；
#   2 讲师公开课的事件 type 从 "news" 改成 "script"。
#
# 为什么是 "script"：crowd_service._EVENT_TYPES_WITH_CROWD = ("festival", "script")，
# "news" 不在里面 —— 所以 active_event_location 永远看不到公开课，
# festival_draw_target 的 ×REALISM_FESTIVAL_WEIGHT 人流拉力对公开课**一次都没生效
# 过**。改 type 是零改动接上那条已经过生产验证的拉力（集市日走的就是它）。
# 不把 "news" 加进那个元组：那会让 NEWS_POOL 的四条随机新闻也长出人流语义。
#
# 不改变的事：零新增 ActionType；零新增经济出口——观众收益只写记忆/心情/social/
# 关系，debate settle 的 5% burn 分账是唯一真金出口，不得双花。
#
# 开闸硬前置（写死，别凭记忆）：
#   1 代码侧——P1 的 location_caps / has_capability / capability_locations 必须已
#     合入，且 CAPABILITIES 里登记了 stage（civic_grantable=true）。
#     本闸**不**依赖 LOCATION_CAPABILITIES_ENABLED：location_capabilities 与
#     has_capability 都是不读闸的纯查询。
#   2 依赖 REALISM_CROWD_ENABLED=true —— ×3 人流拉力由它把关
#     （decide/basic.py 的 _maybe_crowd_draw）。它关着的话本闸只剩 prompt 里多一条
#     事件描述，人流一个不动。
#   3 数据侧——生产 dynamic_locations 里 theater 那行的 data_json 必须已带上
#     capabilities={"stage":{}}。存量行是公投建的，没有这个键；回填是纯数据变更，
#     **必须独立批次**。没回填就开闸不会出事，只是永远解析不到场地、不建事件，
#     与今天等价。
# 护栏 SQL（恒为 0，违反即回滚）：
#   select count(*) from debates
#    where status <> 'settled' and starts_at < now() - interval '2 days';
STAGE_EVENT_ENABLED=false

# ── P2 剧院人流（STAGE_EVENT_CROWD_ENABLED）─────────────────────────────────
# 关（默认）= decide 的 _maybe_stage_crowd 第一行即返回：决策排序与今天逐字节等价、
# 零额外查询、零 LLM。
# 开 = 演出期间（world_events 里有 festival/script 事件，且它 payload 指的那栋楼自己
# 声明了 stage 能力、目的地 tile 与镇区连通），按 sha256 稳定排序挑至多 6 名清醒的
# 自治居民，把这一 tick 定成 VISIT_DISTRICT 去那栋楼（零 LLM）。名单在同一场演出内
# 稳定，已到场的人继续占位、不会被再拉一次。
#
# 为什么这样治「剧院 15 天 0 到访」（design_P2.md §③ 路 B）：不改
# actions.py:80-86 的 CHAT_RESIDENT 判据（附近有 idle/walking 的人才解锁）。改判据
# 会让 LLM 在空场瞎编 target_slug —— 白花钱、吃掉一格日行动 cap、什么都不发生。
# 人真的到场后 idle_nearby 自然非空，锁自己就开了，而其它地点的授权集一个字不变。
#
# 与 REALISM_CROWD_ENABLED 正交：那道闸管的是 ×3 加权抽签（装饰性），本闸是确定性
# 名单（gameplay 拉力），照 caravan lifecycle 的先例解耦。两闸互不为前置。
#
# 开闸硬顺序（写死，别凭记忆）：
#   1 代码侧——P1 的 location_caps 必须已登记 stage（civic_grantable=true），且
#     capability_location_at / location_capabilities 已合入。本闸**不**依赖
#     LOCATION_CAPABILITIES_ENABLED（那两个是不读闸的纯查询）。
#   2 内容侧——必须真的有演出：STAGE_EVENT_ENABLED 开了、辩论/公开课会建出
#     type="script" 且 payload_json.location_id 指向剧院的 world_event。没有演出时
#     本闸开着也完全 inert。
#   3 数据侧（真正的硬前置）——生产 dynamic_locations 里 theater 那行的 data_json
#     必须已带上 capabilities={"stage":{}}。存量行是公投建的，没有这个键；回填是纯
#     数据变更，**必须独立批次**（迁移/数据变更与开闸不同车，07-25 事故红线）。
#     没回填就开闸不会出事，只是名单恒为空、与今天等价。
#
# 开闸后的核验（按天看，别看容器日志——它会轮转；memories.metadata_json 是 json 不是
# jsonb，所有查询必须带 created_at 时间窗）：
#   M3 到访从 0 起飞（基线 0 次 0 人 / 15 天；验收线 visits≥20 且 people≥6）：
#     select count(*) visits, count(distinct m.resident_id) people
#       from memories m
#      where m.metadata_json->'move'->>'target' = 'theater'
#        and m.metadata_json->'move'->>'arrived' = 'true'
#        and m.created_at >= now() - interval '14 days';
#   M4 到访是被事件拉去的（during/(during+off) ≥ 0.6）：
#     with ev as (select id, starts_at, ends_at from world_events
#                  where type='script' and payload_json->>'location_id'='theater')
#     select count(*) filter (where ev.id is not null) during_event,
#            count(*) filter (where ev.id is null)     off_event
#       from memories m
#       left join ev on m.created_at between ev.starts_at and ev.ends_at
#      where m.metadata_json->'move'->>'target' = 'theater'
#        and m.metadata_json->'move'->>'arrived' = 'true'
#        and m.created_at >= now() - interval '14 days';
#
# 开闸后必盯（已知未闭合项）：本分支刻意不落粘性行程（不设 market_trip_event_id——
# tick.py:155-162 会把行程的 kind/location 写死成 market_day/market_hall），所以名单里
# 的人每 tick 重算目的地且每 tick 吃一格 AGENT_MAX_DAILY_ACTIONS（默认 20）。剧院入口
# (172,45) 离镇中心 (75,56) 曼哈顿 108 格 ÷ REALISM_MOVE_SPEED=8 ≈ 14 tick。若当天配额
# 被走路烧光，表现是 M3 的 visits 上不去而 attempts 很高——先查这里，不是查代码。
STAGE_EVENT_CROWD_ENABLED=false
# 坐标反查按「具体性」优先(非 outdoor > 面积小)。关(默认) = 首命中 = 插入序,
# 即邮局被 south_quarter、剧院被 east_gardens 遮蔽的今天。
# 依赖方(真实清单):decide/basic.py 的 dining 判定、_maybe_shelter 的
#   location_is_indoor、location_tracker 首访、location_lore、/exploration/me。
# ⚠ 一次性不可逆:翻开的当下 post_office/theater 的 tile 首次解析成新 slug,
#   location_tracker 会 emit location_first_visit,下挂 explorer_* 成就与赛季分,
#   闸翻回去也收不回。开闸前先跑影响面盘点 SQL 并写进 handoff。
LOCATION_SPECIFIC_FIRST_ENABLED=false

# P2 Task 1 — relationship write deltas (reused outputs, zero new LLM) + decay.
REALISM_REL_FAMILIARITY_CHAT=0.05
REALISM_REL_AFFINITY_CHAT=0.03
REALISM_REL_FAMILIARITY_WITNESS=0.01
REALISM_REL_AFFINITY_GIFT=0.1
REALISM_REL_AFFINITY_INVEST=0.1
# Decay coefficients are PER WORLD-WEEK. agent-T drives the nightly decay off a
# world-week-index crossing (world week = 1.75 real days at k=4), so ×0.95/×0.98
# stay correct — the gate handles the cadence, the coefficients do not change.
# IDLE_DAYS=30 is currently measured in REAL days (decay() uses last_interact_at,
# a real timestamp) → ≈120 world days of silence before an idle tie decays. Kept
# for burn-in (lenient, decay barely fires in a short burn-in). Phase C: when
# world_clock lands, make decay()'s cutoff world-day-aware so "30" means 30 world
# days (≈7.5 real days). See ROADMAP realism §k=4.
REALISM_REL_DECAY_IDLE_DAYS=30
REALISM_REL_FAMILIARITY_DECAY=0.95
REALISM_REL_AFFINITY_DECAY=0.98
# P2 Task 3 — read-path weighted sampling.
REALISM_REL_ENCOUNTER_FAM_COEF=2.0
REALISM_REL_CHAT_EPSILON=0.1
REALISM_REL_GOSSIP_FAM_FLOOR=0.1
# P2 Task 4 — circle detection.
REALISM_CIRCLE_THRESHOLD=0.3
# P2 Task 5 — information gradient.
REALISM_INFO_GEO_RADIUS=15
REALISM_INFO_SAMPLE_FRAC=0.2
REALISM_INFO_GEO_IMPORTANCE=0.6
REALISM_INFO_SAMPLE_IMPORTANCE=0.5
# world_event 记忆分档。梯度管「谁知道」，分档管「多重要」，两件事不耦合。
# 关 = write_collective_memories 与现状逐字节一致（同样的 importance、同样的
# metadata、同样的返回值）；开 = 实质事件（非集市日的节庆 / news / script）改走
# MemoryService.add_memory 参与 per-resident 分位归一，天气与集市日仍旧直写。
# 为什么不整体抬高：生产 1311 条 world_event 记忆里 1253 条（96%）是天气，抬上去
# 就是拿「今天多云」把只有 30 个坑的检索候选池灌满，个人记忆被挤光。
# ⚠️ **已被 REALISM_POOL_WORLD_EVENT_RESERVE 那条专用道取代，保持永久关闭。**
# 抬 importance 会让实质事件同时挤占个人臂（12 周饱和 day28 7/30 → day84 21/30）
# 又吃专用道坑位 —— 双重占坑；而专用道本身就保证**进候选池**（进 prompt 还要靠
# 相关度打赢第 10 名个人记忆，那是想要的行为）。写入侧的档位标记 metadata_json.tier
# 与这个闸门无关（闸开闸关都写、值相同），专用道认的是它。
REALISM_EVENT_MEMORY_TIERED=false
# 实质档的 raw importance。落库值是**分位数**不是它本身：生产归一化窗口（最近 100
# 条）的 raw 分布 p50 0.47 / p90 0.70 / p95 0.70 / max 0.90，0.9 归一后落 0.95 以上，
# 与 civic 结果档同一档位。窗口口径本批不动（world_event 在窗口里只占 1-2/100）。
REALISM_EVENT_MEMORY_IMPORTANCE=0.9
# P2 Task 7 — crowd / 人流聚集.
REALISM_FESTIVAL_LOCATION=central_plaza
REALISM_CROWD_THRESHOLD=5
REALISM_CROWD_SOCIAL_MAX=0.5

# ── Town extension milestones (M1–M6) ────────────────────────────────
# M1 economy: duty wages, meal cost, wallet-pressure hint, resident-made goods, 集市日.
NPC_ECONOMY_ENABLED=true
NPC_DEFAULT_WAGE_SC=5
NPC_MEAL_COST_SC=2
NPC_WALLET_PRESSURE_THRESHOLD=3
NPC_WORK_ITEM_PROB=0.35
NPC_WORK_ITEM_PRICE_SC=15
NPC_WORK_ITEM_STOCK=3
MARKET_DAY_WEEKDAY=5
MARKET_DAY_DISCOUNT=0.9
# 集市日场地: central_plaza = master 原行为(不投影); market_hall = 集市大厅(新文案+
# 读端把历史 central_plaza 行投影到 market_hall)。开 CARAVAN_* 前必须先切 market_hall。
MARKET_DAY_VENUE=central_plaza
# M-A 经济内生化: NPC↔NPC 真实钱流(餐费入账/消费 pass/委托接单/外来商队/分数税账)。
# 三个闸门互相独立、默认全关 → 行为与现状逐字节一致；开闸是单独的部署变更。
NPC_TRADE_ENABLED=false
NPC_TRADE_BUY_PROB=0.25
# Commission willingness and lifetime are independent from product buying.
NPC_COMMISSION_ACCEPT_PROB=0.25
COMMISSION_TTL_HOURS=72
# Commission lifecycle v2:issuer+kind 去重 + TTL 走 COMMISSION_TTL_HOURS。
# 关 = master 行为(无去重、48h 默认 TTL)。
COMMISSION_LIFECYCLE_V2_ENABLED=false
NPC_TRADE_RESERVE_SC=5
NPC_TRADE_MAX_BUYS_PER_NIGHT=2
# Dark first; when true the 4x world clock runs one idempotent demand pass per
# world day and the real-day nightly job stops running its duplicate pass.
NPC_TRADE_WORLD_DAY_ENABLED=false
NPC_TRADE_POPULATION_CAP_RATIO=0.15
ECONOMY_BOOTSTRAP_RESIDENT_FLOOR_SC=12
ECONOMY_BOOTSTRAP_PAYROLL_DAYS=7
# 加固闸:库存扣减走 items.stock 的 guarded UPDATE(迁移 056 必须先落库)。
# durable caravan 会在本键误关时强制使用同一列账本作为安全背板，但正确的硬开闸
# 顺序仍是:056/060/061 迁移 → MARKET_DAY_VENUE=market_hall → ITEM_STOCK_GUARD_ENABLED=true →
# CARAVAN_ENABLED=true(及 binding policy) → CARAVAN_LIFECYCLE_ENABLED=true。
ITEM_STOCK_GUARD_ENABLED=false
# 商队访客的四个真实购买行程由 lifecycle 自身驱动，不依赖
# REALISM_CROWD_ENABLED；后者只控制额外的节庆装饰性人流。
CARAVAN_ENABLED=false
CARAVAN_STALL_FEE_SC=5
CARAVAN_BUDGET_SC=30
# Durable caravan state machine (dark by default; enable only after migration + worker deploy)
CARAVAN_LIFECYCLE_ENABLED=false
# Open only after lifecycle + item stock guard are healthy. The hall remains
# visible in visitor mode while this is false.
MARKET_PLAYER_ENABLED=false
MARKET_CATALOG_VERSION=caravan-market-v1
CARAVAN_LIFECYCLE_INTERVAL_SECONDS=5
CARAVAN_WAIT_LEAD_SECONDS=600
CARAVAN_ROUTE_TILE_MS=150
CARAVAN_LEASE_SECONDS=30
# 分数税账的尾数存 system_config.town_tax_carry_milli(整数 milli-SC,1 SC = 1000);
# 关 = 旧 int() 截断,尾数直接蒸发。
TAX_CARRY_ENABLED=false
# M2 story arcs (rule-based milestone engine, nightly).
ARC_ENGINE_ENABLED=true
# M3 civic governance (proposals → clerk bulletin → NPC+player vote → execute).
CIVIC_POLLS_ENABLED=true
CIVIC_POLL_DAYS=3
# Kill switch for the 2026-07-25 NPC-vote bias fix (option-0 monopoly).
# true → fall back to the pre-fix scorer (A2=M scores nothing, ties resolve to
# index 0). Leave false unless the new scorer misbehaves in production.
CIVIC_NPC_CHOICE_LEGACY=false
# M6 seasonal mayor election.
ELECTION_ENABLED=true
ELECTION_MAYOR_WAGE_BONUS=1.2
# Off-season cadence: nightly trigger opens a new election this many days after
# the last one (an active season instead holds exactly one election per season).
ELECTION_INTERVAL_DAYS=28

# ── E9 辩论擂台生命周期（event_cron 60s 轮询推进）────────────────────────
# 两个窗口都从 debates.starts_at 起算：表里没有记录进入 voting 时刻的列。
# announced 满 STAKE_WINDOW 分钟 → run_live（押注截止，开始辩论）
DEBATE_STAKE_WINDOW_MIN=30
# voting 满 VOTE_WINDOW 分钟（即 starts_at + STAKE + VOTE）→ settle（结算派彩）
DEBATE_VOTE_WINDOW_MIN=60
# 兜底：卡在 announced/live/voting 超过这么多小时 → 平局全额退款，绝不让
# 玩家的押注币无限期冻结（2026-07-28 生产上一笔 10 SC 冻结了 2 天）。
DEBATE_STUCK_HOURS=24

# ── E12/C3 赛季 ─────────────────────────────────────────────────────────
# 自动开季的季长（真实日）。seasons 表长期 0 行 → add_points 全部静默丢弃。
# 默认 28，与上面 ELECTION_INTERVAL_DAYS 保持一致：SEASON_AUTO_OPEN 默认开、
# 部署即生效，开季后选举节奏会从 ELECTION_INTERVAL_DAYS 切到这个值，季末
# 派彩（200/120/80 SC）也会随季长变频——28 避免顺带把两者都改快。
SEASON_LENGTH_DAYS=28
# false = 只允许 admin 手动开季（POST /admin/seasons）
SEASON_AUTO_OPEN=true

# ── S2-1 offices 职位实体化 (POLIS_OFFICE_*) — independent gate, default off ──
# Unified offices table (mayor/town_clerk/postman/doctor) + OfficeService.
# false → byte-level fallback to the pre-S2-1 mayor/duty behavior.
POLIS_OFFICE_ENABLED=false
# Mayor term length in WORLD days (world_clock converts); 0 = unlimited term
# (byte-equivalent to today's overwrite-on-reelection mayor).
POLIS_OFFICE_MAYOR_TERM_DAYS=0
# F3 空缺探针：选举制职位空缺超过这么多真实小时 → overdue_vacancies 亮红旗。
POLIS_OFFICE_VACANCY_ALERT_HOURS=24.0
# ── S1-3 议题立场与舆论动力学 (bounded-confidence opinion dynamics) ──────
# Independent gate, default false → byte-identical fallback (no stance writes,
# no digest opinion_line). Zero new LLM calls in any of the paths.
POLIS_OPINION_ENABLED=false
# Bounded-confidence threshold ε: stances move only when |Δ| <= ε.
POLIS_OPINION_EPSILON=0.4
# Deffuant step sizes: chat-wrapup convergence / nightly drift.
POLIS_OPINION_CHAT_RATE=0.08
POLIS_OPINION_DRIFT_RATE=0.05
# Debate-seed opposing magnitude (exact ±value when the resident lacks SBTI).
POLIS_OPINION_SEED_MAG=0.3
# "Active issue" = touched within this many WORLD days (via world_clock) and
# holding at least this many participants.
POLIS_OPINION_ACTIVE_WINDOW_DAYS=14
POLIS_OPINION_MIN_PARTICIPANTS=3
# negative wrapup mood: false = merely no convergence; true = mild repulsion.
POLIS_OPINION_NEG_REPEL=false
# Digest opinion_line: issues named at most / variance threshold read as 分歧.
POLIS_OPINION_DIGEST_ISSUES=2
POLIS_OPINION_VARIANCE_SPLIT=0.15
# ── S1-1 公共声誉轴 (pure-rule, zero LLM, zero migration) ──────────────
# false → no nightly writes and no election/vote weighting changes.
REP_ENABLED=false
REP_MIN=-1.0
REP_MAX=1.0
REP_NEUTRAL=0.0
REP_EMA_ALPHA=0.3
REP_GOSSIP_BASE_TONE=-0.3
REP_DISTORTION_PENALTY=-0.2
REP_MOOD_WEIGHT=0.2
REP_VOTE_TRUST_WEIGHT=1.0
# 2026-08-05 vm212 实测标定: 拒绝面 2/11;旧值 -0.3 拒绝面为空(装饰性闸门)
REP_CREDIT_MIN_SCORE=0.0058
# ── S1-5 镇财政闭环 (town treasury: tax in / wages + public spending out) ──
# Independent gate, default false → byte-level status quo: duty wages keep
# being MINTED from nothing, resident sales are untaxed, the nightly public
# spending job is skipped whole, no treasury_changed WS event. Zero LLM calls.
TOWN_TREASURY_ENABLED=false
# Town ledger mirror writes (town_treasury_entries) are an independent dark
# gate: open it only as a SECOND change after migration 058 has landed. While
# it is off no treasury flow is journaled — re-anchor the opening balance
# before flipping it on, or the gap window is missing from the books.
TOWN_LEDGER_ENABLED=false
# Sales tax skimmed off a resident-made good's payout (the town's main intake).
TOWN_TAX_RATE_SALES=0.1
# Gift / tip creator-share tax. 0 = knob present but not biting (default).
TOWN_TAX_RATE_GIFT=0.0
# Town treasury empty at wage time: skip = 欠薪 (no credit, no mint)
# / mint = fall back to the pre-S1-5 mint-from-nothing behavior.
TOWN_WAGE_UNFUNDED_POLICY=skip
# Nightly public-works budget in SC. 0 = reconcile only, disburse nothing.
TOWN_PUBLIC_WORKS_DAILY_SC=0
# Broadcast treasury_changed only when |Δbalance| >= this. 0 = never broadcast
# (micro-skims must not spam the WS channel).
TOWN_WS_MIN_DELTA_SC=0
# Sustainable duty payroll is an independent dark gate. false preserves the
# legacy all-duty/perk wage behavior; true pays only public duties at the flat
# rate. Positive trailing-window income is capped by income × budget ratio.
# Requires TOWN_TREASURY_ENABLED=true. TOWN_LEDGER_ENABLED=true is recommended
# so the rolling income budget sees real flows. With the ledger dark, rolling
# income is 0 and wages may use only existing balance above the hard reserve
# floor; the floor itself is never spendable.
TOWN_DUTY_FUNDING_ENABLED=false
TOWN_PUBLIC_DUTY_WAGE_SC=1
TOWN_WAGE_INCOME_WINDOW_DAYS=7
TOWN_WAGE_BUDGET_RATIO=0.70
# Minimum town balance left after every sustainable public-duty wage payment.
TOWN_WAGE_RESERVE_FLOOR_SC=20
# ── S2-5 policies + 四级分级审批 (POLIS_POLICY_*) — two independent gates ──
# Storage gate: false → PolicyService.get/get_group fall back to
# ConfigService(system_config), seed_defaults is a no-op and the policies table
# is neither read nor written by any business path.
POLIS_POLICY_ENABLED=false
# Approval-routing gate: false → approve_proposal keeps the single-admin CAS
# path, _close_one stays pure plurality (no threshold / no quorum) and
# _execute_outcome does not recognize the "policy" effect type.
POLIS_POLICY_APPROVAL_ENABLED=false
# Vote-tier thresholds: 简单多数 / 绝对多数(超多数) winning share.
POLIS_POLICY_SIMPLE_MAJORITY_THRESHOLD=0.50
POLIS_POLICY_ABSOLUTE_MAJORITY_THRESHOLD=0.667
# Absolute-majority tier only: minimum share of eligible voters that must vote.
POLIS_POLICY_QUORUM_FRACTION=0.50

# ── 工程健康批 (2026-07-25B): 聊天锁 DB 侧回收 + 后台 loop 心跳告警 ──
# 运行时由代码直接读 env (运维热改无需重启); Settings 里同名字段只提供默认值。
# R4: worker 猝死会把 residents.status 留在 socializing, 之后互聊全被
# target_busy 静默跳过。回收器挂在 heat_cron 自己的独立块里, fail-open。
SOCIAL_STATUS_RECOVERY_ENABLED=true
# 判定 socializing 卡死的阈值(秒), 默认对齐 ws 的 SOCIAL_LOCK_TTL。
SOCIAL_STATUS_STALE_SECONDS=600
# P2: 五个后台 loop 各写 sv:hb:<loop> 心跳; 心跳过期 → WARN + Sentry,
# 由活着的 loop 替死掉的兄弟报警。false = 一键静默(心跳与告警全停)。
LOOP_HEARTBEAT_ENABLED=true
# 过期阈值 = N × 该 loop 自身节拍。
LOOP_HEARTBEAT_STALE_FACTOR=3
# 阈值下限(秒), 防 60s 级 loop 因单轮变慢误报。
LOOP_HEARTBEAT_MIN_STALE_SEC=900
# 同一 loop 两次告警的最小间隔(分钟)。
LOOP_HEARTBEAT_ALERT_COOLDOWN_MIN=60
# 一次 beat 最多多久触发一次巡检(分钟)。
LOOP_HEARTBEAT_CHECK_INTERVAL_MIN=5

# ── F2 公民权晋升／撤销 (CIVIC_*) — ROADMAP #5 收口已注册进 Settings ────────
# 这 12 个旋钮由 app/services/civic_membership.py 在**调用时**先读进程 env
# （F2 的近百条测试按用例 monkeypatch.setenv 改档位/门槛，赖此成立），env 未设
# 时经 _settings_default 落到 app/config.py 的同名 Settings 字段。两边默认值
# 必须逐字一致（关/保守），由 tests/test_civic_settings_knobs.py 钉住；键名
# 一致性由 tests/test_env_example_consistency.py 的 invariant 1/2 守住。
#
# 三态闸门。off=零读零写；shadow=完整候选计算+全部防呆，只写日志与运行摘要，
# 对 residents / civic_standing_history 零写入；on=真正执行晋升。
# 生产开闸前须先 shadow 观察 ≥3 个夜间周期（批次红线 §7 ④）。
CIVIC_PROMOTION_MODE=off
# 自动下滑降级。默认关；开启必须同时具备滞后三件套（滞后区间/最短任期/冷却期）。
CIVIC_AUTO_DEMOTION_ENABLED=false
#
# ⚠️ 下面三个是**占位值，不是标定值**。assert_thresholds_calibrated 会拿它们
# 挡住 mode=on——必须先用 scripts/civic_calibration_report.py 在真实分布上标定，
# 把值改成实测结果，否则开闸会被拒绝。这正是 rep_credit_min_score 变成装饰性
# 闸门的同一个坑：阈值不能拍。
CIVIC_PROMOTION_MIN_WORLD_DAYS=30.0
CIVIC_PROMOTION_MIN_PEERS=3
CIVIC_PROMOTION_MIN_FAMILIARITY=0.20
#
# 同伴须先过考察期才算“锚定公民”，避免判定的转移函数自指。
CIVIC_PEER_SEASONING_WORLD_DAYS=28.0
# 单夜晋升上限（确定性截断，在熔断判定之后执行）。
CIVIC_PROMOTION_MAX_PER_RUN=5
# 熔断阈值 = max(绝对下限, 公民数 × 比例)。两项缺一不可：只有比例项时小镇规模下
# 熔断恒响，只有下限时世界长大后就不再随规模缩放。
CIVIC_PROMOTION_BREAKER_FRACTION=0.20
CIVIC_PROMOTION_BREAKER_MIN_ABS=3
# 选民基数下限：低于它不做任何晋升（样本太小，比例判据无意义）。
CIVIC_MIN_ELECTORATE=3
# 撤销侧的滞后参数：最短任期 ≥ 一张 poll 的生命周期，冷却期同量级。
CIVIC_MIN_TENURE_WORLD_DAYS=12.0
CIVIC_PROMOTION_COOLDOWN_WORLD_DAYS=12.0
# 实测分布恰好落在占位值上时的显式标定凭据（值写报告日期/commit）。这是一次
# 人为声明，刻意不做成 Settings 字段、平时保持注释状态（civic_promotion.py
# 的 CALIBRATION_ACK_ENV 直读 os.environ）。
#CIVIC_THRESHOLDS_CALIBRATED=

# ── 世界公共记忆 (CIVIC_FACTS_* / CIVIC_MEMORY_*) ──────────────────────────
# 两个总闸互相独立、默认全关 → 行为与现状逐字节一致：事实层关 = prompt 里不多
# 一个字，广播层关 = 镇务事件不写任何居民记忆。零新表零迁移，所以代码可以随部署
# 暗上，两个总闸各自是一次独立的部署变更（红线：行为开闸与代码变更不同车）。

# 事实层：把"镇长是谁/在议什么/今天是不是集市日"这类公共事实注入玩家对话与
# 居民决策的 prompt。关 = build_town_facts 恒返回 {}。
CIVIC_FACTS_ENABLED=false

# --- P3 开闸硬顺序（七道闸的赋值行由各自 step 已写入本文件，此处只排顺序）---
#  1) WORLD_RELOAD_RESET_PATH_CACHE —— 先让运行中新建的楼当场可达
#  2) LOCATION_SPECIFIC_FIRST_ENABLED —— 真实依赖方是:decide/basic.py 的
#     dining 判定、_maybe_shelter 的 location_is_indoor、location_tracker 首访、
#     location_lore、/exploration/me。**它不是 P1 能力闸的前置**:P1 的两个能力门
#     走 map_data.capability_location_at(自带穿透遮蔽的最小面积匹配),不经
#     get_location_id_at —— 旧文案里那句「必须先于任何依赖 get_location_id_at 的
#     P1 能力闸」是错的,照它排会假报「P1 接线失败」。
#     商队路面语义已由 P3-S8b 解耦(outdoor_container_at),不再受本闸影响,
#     但 **S8b 必须先合入** 再翻本闸。
#     ⚠ 本闸一次性不可逆:翻开当下触发 post_office/theater 的
#     location_first_visit → explorer_* 成就与赛季分,关回去收不回。
#  3) CIVIC_BUILD_SCHEMA_ENABLED + CIVIC_BUILD_VALIDATE_ENABLED —— 校验先于
#     下一次公投建楼生效
#     ⚠ CIVIC_BUILD_VALIDATE_ENABLED 另有一条跨批次前置:库里存量剧院的 bounds
#     今天就是越界的,先翻本闸再重跑剧院 effect 会被自己的校验拒收。正确序是
#     「P3-S13 迁移 068 → P3-S14 CIVIC_AGENDA 坐标字面量同步 → 才翻本闸」,
#     且迁移与开闸**不得同批**(红线:迁移/清库 与 开闸/行为变更不同车)。
#  4) CIVIC_EFFECT_AUDIT_ENABLED / CIVIC_FACTS_PLACES_DYNAMIC_RESERVE(任意序)
#     建议把 CIVIC_EFFECT_AUDIT_ENABLED 排到 3) 之前:两者无代码耦合(审计关着
#     几何校验照样拒收,只是不记账),但校验上线后第一批被拒的公投若没有审计,
#     在库里与「执行时炸了」长得一模一样,事后无从复盘。
#  5) CIVIC_BUILD_OPENING_EVENT_ENABLED —— 须同时开 REALISM_CROWD_ENABLED,
#     否则庆典零位移拉力
#     两份模板对 REALISM_CROWD_ENABLED 取值不同:backend 那份是 true(开发意向),
#     deploy 那份是 false —— **以 deploy 那份为准,生产现在是关的**。
# 公投/Lab 建楼载荷的白名单投影 + type 缺省 + 非法动作码剔除。
# 关(默认) = effect.data 除 slug 外整包落库 = 逐字节旧行为。
# 开 = 未登记键被丢弃并记 warning;capabilities 归一成 dict 后按
#      location_caps.CIVIC_GRANTABLE_CAPABILITIES 白名单过滤。
CIVIC_BUILD_SCHEMA_ENABLED=false
# 建楼落库前的几何校验:outdoor 街区重叠降级为 warning(否则邮局这类合法楼
# 被误杀)、楼压楼仍是 error、bounds/入口须落在 walkable 域 [14,173]x[12,123]、
# 入口须落在 central_plaza 的连通分量上(判据是 get_reachable_tiles,
# 不是会自证的 get_walkable_tiles)。公投是 upsert,同 slug 不算冲突。
# 关(默认) = 只校验 slug 非空 + bounds 存在 = 逐字节旧行为(剧院照样落界外)。
CIVIC_BUILD_VALIDATE_ENABLED=false
# 公共事实快照的 TTL（秒，每个 worker 进程内一份；self 段是 per-resident 的，
# 永远不进这层缓存）。
CIVIC_FACTS_CACHE_TTL_SECONDS=60.0
# 有界 fail-open：取数失败时可以继续用旧快照顶一会儿，但超过这个岁数就宁可
# 不注入——注入一个过期的镇长比不注入更糟。每次 fail-open 打
# CIVIC_FACTS_FAILOPEN 日志 + civic_facts_failopen_total 计数。
CIVIC_FACTS_MAX_STALE_SECONDS=600.0
# 「小镇有哪些地方」名单(PLACES_LIMIT=12)里给公投新建的楼留几个坑。
# 0(默认) = 逐字节旧行为:静态设施在前占满,新楼永远被挤掉。
# 开到 N:动态先占最多 N 个坑,没填满的坑退还给静态(len(places) 与改前恒等);
# 渲染顺序仍是静态在前(prompt 前缀缓存不抖),只有名额分配先给动态。
CIVIC_FACTS_PLACES_DYNAMIC_RESERVE=0
# 公投执行结果写回 options_json[0](_effect_applied / _effect_error)+ 计数器。
# 关(默认) = 失败原因只剩一句中文公告 + 一行 logger.warning,
#            「类型不支持」「执行抛异常」「选址不合规」三者不可区分。
# 开 = 错误分码入库并进 CIVIC_EFFECT_APPLIED 计数器;错误码不出网
#      (script_service.public_option 是白名单投影)。
CIVIC_EFFECT_AUDIT_ENABLED=false
# 新楼落成庆典:一条 type="festival" 的世界事件(天数取 effect.data 的
# opening_event_days,0/缺省/bool = 不开,上限 7 天),与建楼同一次 commit。
# 关(默认) = 不建任何事件。
# ⚠ 开闸硬前置:只有**同时**开 REALISM_CROWD_ENABLED 才有位移拉力 ——
#   crowd_service._EVENT_TYPES_WITH_CROWD 是 ("festival","script") 闭集,
#   x3 抽签偏置由那道闸把关;不开就只有记忆与 prompt 里提一嘴,零人流。
#   本文件里那道闸写在上面的 Realism P2 段(REALISM_CROWD_ENABLED=true),
#   deploy/backend/.env.example 原本没有那一行(生产取代码默认 False),
#   已在那份模板里显式写成 false —— 开本闸前先去核对那边的值。
CIVIC_BUILD_OPENING_EVENT_ENABLED=false

# ── 世界重载时的路网缓存失效 (WORLD_RELOAD_*) ──────────────────────────────
# reload_world 顺带清 pathfinder 路径缓存与 caravan 路网 lru_cache。
# 关(默认) = 运行中新建的楼要等进程重启才走得到(find_path 的
#            to_tile not in walkable 直接 return None)。
# 触发频率(别按「每 tick」估):reload_world 只有这些调用点 —— 进程启动
#   (main.py:87 / agent/main.py:59 / lab/main.py:421)、lab apply/revert
#   (apply.py:210,284)、proposal apply/revert(proposal_service.py:305,370)、
#   公投落库(civic_service.py:932),外加每进程一个 world_reload_subscriber
#   (apply.py:338) 把上述任一次广播成「每进程各重算一次」。
#   **agent tick 不调它**,不在 NPC 热路径上。
# 单次代价(本机实测):tilemap 6.1MB 解析+全量重扫 18.35ms + BFS 4.28ms,
#   下一次商队路网重建再 38.42ms —— 合计约 61ms 同步阻塞/进程/次,
#   日常量级是「结票/审批」那种个位数次/天。因此**不加节流器**:
#   加了反而让「新楼何时可达」变得不可预测。清完是惰性重建,重算落在清完后
#   第一个碰它的协程里。
WORLD_RELOAD_RESET_PATH_CACHE=false

# 记忆广播：把镇务事件写成全体自治居民（npc + UGC resident，player 不收）的
# 一等事件记忆，走 MemoryService.add_memory 参与分位归一。
CIVIC_MEMORY_BROADCAST_ENABLED=false
# 两档 raw importance：结果类（选举结果/议案生效）高，征询与日常公告低一档，
# 免得公告把只有 30 个坑的检索候选池挤满。
CIVIC_MEMORY_IMPORTANCE=0.9
CIVIC_MEMORY_NOTICE_IMPORTANCE=0.6
