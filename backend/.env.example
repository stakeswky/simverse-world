# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skills_world
# Dev only: auto-create tables from models at startup (production uses `alembic upgrade head`)
AUTO_CREATE_TABLES=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Dev mode: allows the default JWT secret. Never enable in production.
DEBUG=true

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string

# GitHub OAuth (optional for MVP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LLM Config
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=512

# SearXNG (research)
SEARXNG_URL=http://localhost:58080

# Portrait generation (Gemini via proxy)
PORTRAIT_LLM_MODEL=gemini-3-pro-image-preview
PORTRAIT_LLM_BASE_URL=http://localhost:3000/v1
PORTRAIT_LLM_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173"]
# Anonymous Challenge Town accepts credentialed mutations only from this exact
# public UI origin. Keep it a CORS subset.
CHALLENGE_ALLOWED_ORIGINS=["http://localhost:5173"]
# Local HTTP development is intentionally non-secure; production must set true.
CHALLENGE_COOKIE_SECURE=false

# External Agent players. Keep self-registration off in production unless the
# deployment has an approval/abuse-control policy in front of this endpoint.
AGENT_SELF_REGISTRATION_ENABLED=false
AGENT_PLAYER_SESSION_MINUTES=15
AGENT_VIEWER_SESSION_MINUTES=60
AGENT_PAIRING_MINUTES=10
AGENT_MOVE_MAX_TILES=4
AGENT_OBSERVATION_RADIUS_TILES=12
AGENT_OBSERVATION_EVENT_LIMIT=20
AGENT_MESSAGE_MAX_CHARS=280
AGENT_PRESENCE_TTL_SECONDS=90
# Durable hosted Agent runner. Keep disabled until a versioned AES-256-GCM
# keyring is provisioned. Format:
#   HOSTED_AGENT_RUNNER_ACTIVE_KEY_ID=<kid>
#   HOSTED_AGENT_RUNNER_KEYRING={"<kid>":"<base64url-32-byte-key>", ...}
# New writes encrypt with ACTIVE_KEY_ID; older key ids remain for decrypt/rotation.
HOSTED_AGENT_RUNNER_ENABLED=false
HOSTED_AGENT_RUNNER_ACTIVE_KEY_ID=
HOSTED_AGENT_RUNNER_KEYRING=
HOSTED_AGENT_RUNNER_ALLOWED_HOSTS=[]
HOSTED_AGENT_RUNNER_INTERNAL_API_BASE=http://localhost:8000
HOSTED_AGENT_RUNNER_MAX_CONCURRENT=3
HOSTED_AGENT_RUNNER_LLM_TIMEOUT_SECONDS=60
HOSTED_AGENT_RUNNER_LEASE_SECONDS=180
HOSTED_AGENT_RUNNER_POLL_SECONDS=2
HOSTED_AGENT_RUNNER_MAX_RESPONSE_BYTES=262144
# 主 tick 跳过 chatting/socializing(chatting 无 Redis 锁时自愈复位 idle)。
# 关 = master 行为:主 tick 仅跳 sleeping。
CHAT_ENGAGED_TICK_SKIP_ENABLED=false
# 集体记忆收件人:开 = 只写给 sim 居民(npc/resident),玩家化身不收。
# 关 = master 行为:仅排 sleeping,玩家化身照收 world_event 记忆。
COLLECTIVE_MEMORY_SIM_ONLY=false

# Observability (Phase 3)
# Sentry stays off unless a DSN is set (applies to API and agent-worker).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus GET /metrics (per-worker registry; see app/observability.py)
METRICS_ENABLED=true
# Bearer token for GET /metrics (empty = open; set when /metrics is public)
METRICS_TOKEN=
# Log SQL statements slower than N ms via logger "app.slow_query" (0 = off)
SLOW_QUERY_MS=0

# Process topology (P0-3)
# Run agent/heat/embedding loops inside the API process. Set false when the
# standalone agent-worker container owns them (deploy compose does this).
RUN_BACKGROUND_TASKS=true

# Auth extras
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GITHUB_REDIRECT_URI=

# LinuxDo OAuth (optional)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=
LINUXDO_MIN_TRUST_LEVEL=0

# Custom LLM endpoint (relay/aggregator; overrides ANTHROPIC_API_KEY when set)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Disable thinking/reasoning for faster responses
LLM_THINKING=false
# Per-attempt LLM usage telemetry -> llm_usage table (P1-1)
LLM_METERING_ENABLED=true
# Pin background/system calls to a cheaper model (empty = same as player-visible)
BACKGROUND_LLM_MODEL=

# Budget circuit breaker (P1-1); 0 disables each cap
# Global cap raised 1.5→10.0 for the world-clock k=4 speed-up (daily actions now
# reset per WORLD day; ≈$6/real-day for a 15-resident world stays under this).
BUDGET_GLOBAL_DAILY_USD=10.0
BUDGET_USER_DAILY_USD=0.5
BUDGET_FORGE_REQUEST_USD=0.15

# System/user LLM advanced params
SYSTEM_LLM_TEMPERATURE=0.3
SYSTEM_LLM_TIMEOUT=30
SYSTEM_LLM_MAX_RETRIES=2
USER_LLM_TEMPERATURE_CHAT=0.7
USER_LLM_TEMPERATURE_FORGE=0.5
USER_LLM_TIMEOUT=120
USER_LLM_MAX_RETRIES=3
USER_LLM_CONCURRENCY=5
# Allow players to configure their own LLM endpoint in settings
ALLOW_USER_CUSTOM_LLM=false

# Portrait extras
PORTRAIT_LLM_TIMEOUT=180
# Pixel-art post-processing (Image-to-Pixel style): output grid resolution
# (character fits an N x N pixel canvas) and max palette size
PORTRAIT_PIXEL_GRID=64
PORTRAIT_PIXEL_COLORS=32

# TTS (E5; empty base URL disables external calls)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_DAILY_FREE_QUOTA=30

# Media upload — must stay UNDER the served static root (STATIC_DIR, default
# "static"), otherwise uploaded-media URLs 404. Relative to the process CWD.
STATIC_DIR=static
# Non-public, durable working tree for resident sprite candidates. Keep this
# outside STATIC_DIR so unapproved images cannot be fetched via /static.
RESIDENT_SPRITE_ENABLED=false
RESIDENT_SPRITE_ARTIFACT_DIR=var/resident-sprites
# Optional local generation worker configuration. Leave base URL/key/receipt
# empty to make queued jobs fail closed with SPRITE_PROVIDER_NOT_CONFIGURED.
RESIDENT_SPRITE_PROVIDER_BASE_URL=
RESIDENT_SPRITE_PROVIDER_API_KEY=
RESIDENT_SPRITE_PROVIDER_MODEL=gpt-image-2
RESIDENT_SPRITE_PROVIDER_TIMEOUT=180
# Test only: permits credentials over non-loopback HTTP. Never enable in production.
RESIDENT_SPRITE_ALLOW_INSECURE_HTTP_TEST=false
# Conservative per-image-request cost ceiling in USD. Set from the provider's
# current price before generation; 0 means unknown and is shown as such.
RESIDENT_SPRITE_REQUEST_COST_UPPER_BOUND_USD=0
RESIDENT_SPRITE_CAPABILITY_RECEIPT=
RESIDENT_SPRITE_REVOCATION_ROOT=var/resident-sprites/revocations
RESIDENT_SPRITE_WORKER_POLL_SECONDS=5
RESIDENT_SPRITE_WORKER_LEASE_SECONDS=7200
MEDIA_UPLOAD_DIR=static/uploads
MEDIA_MAX_IMAGE_SIZE=5242880
MEDIA_MAX_VIDEO_SIZE=52428800
VIDEO_LLM_MODEL=kimi-k2.5

# Embedding provider
# Master switch — set false on deploys with no embedding endpoint (memory
# retrieval falls back to importance/recency instead of failing per call)
EMBEDDING_ENABLED=true
# OpenAI-compatible endpoint (百炼 compatible-mode / one-api / OpenAI);
# takes priority over Ollama below when set. dimensions passed explicitly.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# Compensation queue canary: begin at 100 rows / 10 minutes. After observing
# provider latency/errors and DB load for >=1h, raise BATCH_SIZE to 400.
EMBEDDING_BACKFILL_BATCH_SIZE=100
EMBEDDING_BACKFILL_INTERVAL_SECONDS=600
EMBEDDING_BACKFILL_REQUEST_SIZE=50

# Ollama (local embedding fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_EMBED_DIMENSIONS=1024

# Agent loop
# Master switch — vm212 keeps this false (Coding Plan terms forbid backend automation)
AGENT_ENABLED=true
AGENT_TICK_INTERVAL=60
AGENT_MAX_CONCURRENT=5
AGENT_MAX_DAILY_ACTIONS=20
AGENT_CHAT_MAX_TURNS=8
AGENT_CHAT_COOLDOWN=1800
AGENT_DEBUG_ALWAYS_ACTIVE=false

# World clock (agent-T): world time = WORLD_EPOCH + k×(real elapsed). k=4 → 1 real
# day = 4 world days. Residents' schedule/weekday/date read world time; budget/cron
# /TTL/logs stay real time. See docs/ROADMAP.md (已确定的运行口径).
WORLD_CLOCK_K=4
WORLD_EPOCH=2026-01-01T00:00:00+08:00
TIMEZONE=Asia/Shanghai

# Rate limiting (P1-1 limit sub-item)
WS_RATE_LIMIT_PER_MINUTE=20
REST_RATE_LIMIT_REGISTER_PER_MINUTE=5
REST_RATE_LIMIT_FORGE_PER_MINUTE=10
REST_RATE_LIMIT_IMPORT_PER_MINUTE=10
REST_RATE_LIMIT_RESIDENT_EDIT_PER_MINUTE=10
UGC_DAILY_CREATION_LIMIT=3
FORGE_DAILY_REWARD_LIMIT=3
FORGE_SESSION_TTL_HOURS=24
REST_RATE_LIMIT_LLM_TEST_PER_MINUTE=5
REST_RATE_LIMIT_PROPOSE_PER_MINUTE=5   # polls/propose — 开公投是写 + 全镇广播

# Lab / experiment building (spec §13) — master switch defaults OFF; enable explicitly
LAB_ENABLED=false
LAB_ADAPTER=mock                       # mock|codex|openclaw|hermes|computer_use
# Empty JSON list = historical open admission once LAB_ENABLED is on. Populate
# user ids for a closed beta; admins are admitted automatically.
LAB_BETA_USER_IDS=[]
LAB_CREATOR_SHARE=0.2                  # researcher's creator's share of reward_sc; rest → treasury
LAB_PLATFORM_FEE_RATE=0.1              # platform fee on top of reward → sink
LAB_MAX_CONCURRENT_RUNS=3
LAB_MAX_CONCURRENT_PER_RESEARCHER=1    # per-researcher cap on concurrently-running runs (0 = disabled)
LAB_DAILY_TASKS_PER_USER=20
LAB_DEFAULT_BUDGET_USD=0.5
LAB_SC_PER_USD=100
LAB_MODEL_POLICY_VERSION=lab-deepseek-v1
LAB_PRO_MIN_REWARD_SC=100              # reward >= this uses deepseek-v4-pro
LAB_FLASH_BUDGET_USD=0.25
LAB_PRO_BUDGET_USD=0.5
LAB_MODEL_GATEWAY_BASE_URL=            # Responses endpoint base, ending in /v1
LAB_MODEL_GATEWAY_AUTH_SECRET=         # dedicated 32+ byte run-token signing secret
LAB_MODEL_GATEWAY_TOKEN_TTL_S=300
LAB_CODEX_BASE_URL=                    # ARM Codex Runtime HTTP endpoint
LAB_CODEX_API_KEY=                     # dedicated 32+ byte backend-to-runtime key
LAB_APPROVAL_TIMEOUT_S=1800            # sensitive-action human-review timeout (default: deny)
LAB_RUN_HEARTBEAT_TTL_S=300           # orphan-run watchdog threshold
LAB_AUTO_RELEASE_HOURS=72             # review→auto-release window
LAB_TASK_DEADLINE_HOURS=24
LAB_SANDBOX_IMAGE=                     # container image for isolated runs ("" = not provisioned)
LAB_EGRESS_ALLOWLIST=[]                # allowed egress hosts, JSON list e.g. ["*.wikipedia.org"]
LAB_OCI_ENABLED=false                  # route R1 code/shell tools through the rootless OCI sandbox executor
LAB_OCI_IMAGE=                         # OCI executor image ("" = disabled even if LAB_OCI_ENABLED=true)
# Real sandbox adapters (empty base_url → adapter.start() raises LabAdapterUnconfigured)
LAB_SIMVERSE_REF_BASE_URL=             # Phase 7 selected candidate: the reference runtime endpoint
LAB_RUNTIME_BASE_URL=                  # Release-gate/staging alias for the same Runtime endpoint
LAB_SIMVERSE_REF_API_KEY=
# Operator-supplied commercial runtime endpoint (P7 candidate; Anthropic-compatible)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
LAB_OPENCLAW_BASE_URL=
LAB_OPENCLAW_API_KEY=
LAB_HERMES_BASE_URL=
LAB_HERMES_API_KEY=
LAB_COMPUTER_USE_BASE_URL=
LAB_COMPUTER_USE_API_KEY=

# Lab Agent v1 (P0/P1 protocol + safety slice) — new grant/policy/broker/ledger
# path; master switch defaults OFF (legacy mock path stays live until cut over)
LAB_AGENT_V1_ENABLED=false
LAB_GRANT_SECRET=                      # HMAC secret for run grants ("" = fall back to JWT_SECRET)
LAB_GRANT_TTL_S=900                    # grant TTL (PRD: 15 min)
LAB_POLICY_VERSION=lab-policy-v1
LAB_BUDGET_MODEL_TOKENS=200000
LAB_BUDGET_TOOL_CALLS=100
LAB_BUDGET_WALL_CLOCK_MS=1200000       # 20 min
LAB_BUDGET_EGRESS_REQUESTS=200
LAB_BUDGET_EGRESS_BYTES=104857600      # 100 MiB
LAB_BUDGET_ARTIFACT_COUNT=20
LAB_BUDGET_ARTIFACT_BYTES=104857600
LAB_BUDGET_ACTIVE_WORKERS=3
LAB_ARTIFACT_RETENTION_DAYS=30          # V12: artifact expires_at window; held (referenced) evidence is never swept

# Protocol-v2 rollout gates. Keep false until their Postgres/staging/D0 oracles
# pass. A v2 run never falls back to protocol v1 or Mock.
LAB_AGENT_V2_ENABLED=false
LAB_TERMINALIZER_V2_ENABLED=false
# The Lab Runner always recovers v1 commands/events; this enables the dedicated v2 consumer.
LAB_TERMINALIZER_WORKER_ENABLED=false
LAB_TERMINALIZER_DATABASE_URL=        # dedicated lab_terminalizer_v2 DSN; required with the v2 worker
LAB_OUTBOX_V2_ENABLED=false
LAB_RUNTIME_V2_CANARY_ENABLED=false
LAB_GLOBAL_ADMISSION_ENABLED=false
LAB_SERVICE_SHA=
LAB_D0_RELEASE_RECEIPT_PATH=
LAB_D0_RELEASE_RECEIPT_SHA256=
LAB_D0_REQUEST_HASH=
# Dedicated Gateway -> Runtime service JWT ring. Do not reuse JWT_SECRET or
# LAB_SIMVERSE_REF_API_KEY. Leave blank while the v2 canary is disabled.
LAB_RUNTIME_AUTH_ISSUER=
LAB_RUNTIME_AUTH_AUDIENCE=lab-runtime
LAB_RUNTIME_AUTH_CURRENT_KID=
LAB_RUNTIME_AUTH_CURRENT_KEY=
LAB_RUNTIME_AUTH_NEXT_KID=
LAB_RUNTIME_AUTH_NEXT_KEY=
LAB_RUNTIME_AUTH_TOKEN_TTL_S=300
LAB_RUNTIME_V2_CANARY_TENANTS=[]

