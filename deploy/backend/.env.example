LINUXDO_REDIRECT_URI=

# Resident autonomous behavior (AgentLoop, runs in the agent-worker service).
# Production default has been OFF historically — set true to bring residents
# to life (movement, self-directed chats, feed events).
AGENT_ENABLED=true
# Agent-worker 决策 LLM 端点（与上面的 LLM_* 世界观线是两条独立配置）。
# 这三键必须活在 deploy/.env（compose env_file 注入进程 env）——不要放
# backend/.env：那份文件会被烤进镜像，且不受部署脚本管理。
AGENT_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
AGENT_API_KEY=sk-xxx
AGENT_MODEL=qwen3.7-plus

# Static files (uploaded media, AI portraits, and approved resident sprites)
# are served from /app/static inside the container and persisted by the
# media_static volume. Unapproved sprite candidates stay in the separate,
# non-public resident_sprite_artifacts volume.
STATIC_DIR=/app/static
MEDIA_UPLOAD_DIR=/app/static/uploads
RESIDENT_SPRITE_ENABLED=false
RESIDENT_SPRITE_ARTIFACT_DIR=/var/lib/simverse/resident-sprites
# Provider credentials and generation pricing belong in the worker-only
# resident-sprite-worker.env file; never place them in this shared file.
# Qualified receipt is mounted read-only into the agent-worker. Set both vars
# only after probe/qualification/review has produced a current receipt.
# Container path is fixed by compose; configure the host-side source below.
RESIDENT_SPRITE_CAPABILITY_RECEIPT=/run/secrets/resident-sprite-capability.json
RESIDENT_SPRITE_CAPABILITY_RECEIPT_HOST_PATH=
RESIDENT_SPRITE_REVOCATION_ROOT=/var/lib/simverse/resident-sprites/revocations

# Observability. /metrics is served by the API process itself; with an empty
# METRICS_TOKEN it is unauthenticated and leaks every /admin/* route name and
# its call volume. Binding the API to loopback only blocks *direct* access to
# the port — cloudflared (or any reverse proxy) still forwards the whole
# origin, so https://<api-host>/metrics stays reachable from the public
# internet through the tunnel. Fail closed: leave this disabled until you set
# a real METRICS_TOKEN below, then flip it to true for your Prometheus
# scrape_config's bearer_token.
METRICS_ENABLED=false
METRICS_TOKEN=

# ── 政治层三条线 (F1 声誉 / F2 公民权 / F3 任期) — ROADMAP #5 收口 ─────────
# 默认全关/保守。开闸是独立变更（红线：行为开闸与代码/部署变更分开）；
# CIVIC_PROMOTION_MODE=on 前必须先 shadow 观察 ≥3 个夜间周期 + 标定占位门槛。
# 键与语义详见 backend/.env.example 对应段（本文件保持同键同默认，由
# tests/test_env_example_consistency.py::test_governance_knobs_exist_in_deploy_env_example_too 守住）。

# M3 civic 治理基座（proposals → 投票 → 执行）。F2 的晋升闸门与 F3 的补选
# 都跑在它上面（trigger_backfill 的 gate 读 CIVIC_POLLS_ENABLED）。这三个是
# 既有代码默认（生产同值），不是本批新开关。
CIVIC_POLLS_ENABLED=true
CIVIC_POLL_DAYS=3
CIVIC_NPC_CHOICE_LEGACY=false

# F3/S2-1 职位实体化：false → offices 表不读不写，nightly term_check 整段跳过
POLIS_OFFICE_ENABLED=false
POLIS_OFFICE_MAYOR_TERM_DAYS=0
POLIS_OFFICE_VACANCY_ALERT_HOURS=24.0

# F1/S1-1 公共声誉轴（REP_CREDIT_MIN_SCORE 已按 vm212 真实分布标定：0.0058，拒绝面 2/11，
# 证据见 docs/reports/2026-08-05-rep-gate-assessment.md；开闸走该报告 §5 六步单）
REP_ENABLED=false
REP_MIN=-1.0
REP_MAX=1.0
REP_NEUTRAL=0.0
REP_EMA_ALPHA=0.3
REP_GOSSIP_BASE_TONE=-0.3
REP_DISTORTION_PENALTY=-0.2
REP_MOOD_WEIGHT=0.2
REP_VOTE_TRUST_WEIGHT=1.0
REP_CREDIT_MIN_SCORE=0.0058

# F2 公民权晋升/撤销三态闸门：off=零读零写；shadow=只算名单不写库；on=真晋升
CIVIC_PROMOTION_MODE=off
CIVIC_AUTO_DEMOTION_ENABLED=false
# ⚠️ 下面三个门槛是占位值：mode=on 会被 assert_thresholds_calibrated 拒绝，
# 必须先用 scripts/civic_calibration_report.py 实测标定
CIVIC_PROMOTION_MIN_WORLD_DAYS=30.0
CIVIC_PROMOTION_MIN_PEERS=3
CIVIC_PROMOTION_MIN_FAMILIARITY=0.20
CIVIC_PEER_SEASONING_WORLD_DAYS=28.0
CIVIC_PROMOTION_MAX_PER_RUN=5
CIVIC_PROMOTION_BREAKER_FRACTION=0.20
CIVIC_PROMOTION_BREAKER_MIN_ABS=3
CIVIC_MIN_ELECTORATE=3
CIVIC_MIN_TENURE_WORLD_DAYS=12.0
CIVIC_PROMOTION_COOLDOWN_WORLD_DAYS=12.0
# 实测分布恰好落在占位值上时的显式标定凭据（值写报告日期/commit），平时保持注释
#CIVIC_THRESHOLDS_CALIBRATED=

# ── M-A 经济内生化（NPC↔NPC 真实钱流）─────────────────────────────────
# 经济闸默认全关。先随代码暗上全部迁移，再单独变更开 NPC_TRADE_ENABLED +
# TAX_CARRY_ENABLED；商队不能沿用旧的“随后直接开 CARAVAN”顺序，必须执行下方
# ①→⑤ 的库存、场地、政策、生命周期硬顺序。
# ⚠️ TAX_CARRY_ENABLED 必须与本仓 TOWN_TREASURY_ENABLED 分开翻：镇库在产已开，
# carry 若不独立设闸，暗上就等于「迁移 + 在产玩家路径行为变更」同车（红线）。

# 公共工资可持续性独立暗闸。部署新代码时保持 false；完成 ledger 对账并明确
# 开闸后，只有 public duty 按 1 SC/次领取镇薪，近 7 日工资不超过真实收入 70%。
TOWN_DUTY_FUNDING_ENABLED=false
TOWN_PUBLIC_DUTY_WAGE_SC=1
TOWN_WAGE_INCOME_WINDOW_DAYS=7
TOWN_WAGE_BUDGET_RATIO=0.70

# C1 餐费入账 + C2 NPC 消费 pass + C3 NPC 接单/结算（nightly 段落 #23）
NPC_TRADE_ENABLED=false
NPC_TRADE_BUY_PROB=0.25
NPC_COMMISSION_ACCEPT_PROB=0.25
COMMISSION_TTL_HOURS=72
NPC_TRADE_RESERVE_SC=5
NPC_TRADE_MAX_BUYS_PER_NIGHT=2
NPC_TRADE_WORLD_DAY_ENABLED=false
NPC_TRADE_POPULATION_CAP_RATIO=0.15
ECONOMY_BOOTSTRAP_RESIDENT_FLOOR_SC=12
ECONOMY_BOOTSTRAP_PAYROLL_DAYS=7

# C4 外来商队硬开闸顺序（禁止跳步）：
# ① alembic 已到 061（包含 056 items.stock、060 lifecycle、061 visitors）
# ② MARKET_DAY_VENUE=market_hall
# ③ ITEM_STOCK_GUARD_ENABLED=true
# ④ CARAVAN_ENABLED=true，并确认 binding policy 的 caravan_enabled 也是 true
# ⑤ 最后 CARAVAN_LIFECYCLE_ENABLED=true
# lifecycle 在③误配时也会强制所有库存消费者走列 CAS，避免双账本；这是代码安全
# 背板，不是允许跳步。四名真实访客由 lifecycle 自己定向到购买 slot，和
# REALISM_CROWD_ENABLED 无关；该 realism 闸只控制额外的装饰性节庆人流。
MARKET_DAY_VENUE=market_hall
ITEM_STOCK_GUARD_ENABLED=false
CARAVAN_ENABLED=false
CARAVAN_STALL_FEE_SC=5
CARAVAN_BUDGET_SC=30
# Durable caravan state machine (dark by default; enable only after migration + worker deploy)
CARAVAN_LIFECYCLE_ENABLED=false
MARKET_PLAYER_ENABLED=false
MARKET_CATALOG_VERSION=caravan-market-v1
CARAVAN_LIFECYCLE_INTERVAL_SECONDS=5
CARAVAN_WAIT_LEAD_SECONDS=600
CARAVAN_ROUTE_TILE_MS=150
CARAVAN_LEASE_SECONDS=30

# C5 分数税账：税的尾数累进 system_config.town_tax_carry_milli；关 = 旧 int() 截断。
# 值是**整数 milli-SC**（1 SC = 1000），走数据库内原子增量，跨进程并发不丢尾数。
# 开闸后读数：select value from system_config where key='town_tax_carry_milli';
#            → 0 ≤ 值 < 1000（超过 1000 说明兑换那步没跑）
TAX_CARRY_ENABLED=false

# ── 世界公共记忆（CIVIC_FACTS_* / CIVIC_MEMORY_*）──────────────────────────
# 零新表零迁移。两个总闸互相独立、默认全关 → 行为与现状逐字节一致。开闸分两次
# 独立变更，且**禁止裸 `docker compose up -d`**（那会重跑 bootstrap 的
# alembic upgrade + seed）——改完 .env 用：
#     cd /opt/skills-world/deploy && docker compose up -d --no-deps api agent-worker
# 键与语义详见 backend/.env.example 对应段（本文件保持同键同默认，由
# tests/test_env_example_consistency.py::test_governance_knobs_exist_in_deploy_env_example_too 守住）。
#
# ── 每一次 compose 动作之前跑的只读 pre-flight（必须返回 0 行）──────────────
# 裸 `docker compose up -d` 会重跑 bootstrap 的 `seed.reset_builtin_residents`，
# 它的删除判据有**两支**（seed/reset_builtin_residents.py:82-94 的 or_()）：
#   resident_type <> 'player'
#   AND (slug ∈ LEGACY_BUILTIN_SLUGS  OR  creator_id = SYSTEM_USER_ID)
#   AND slug ∉ NEW_ROSTER_SLUGS
# 命中者连同它的记忆/关系/会话等 13 张表级联删除。守卫 SQL 必须把两支都查上——
# 只查 creator_id 那一支的话，一位跟老 demo NPC 重名（klaus / isabella / adam /
# mei / tamara 之类的通名，玩家完全可能撞上）的 UGC 居民会被安静删掉，而
# pre-flight 照样返回 0 行。今天生产两支都无人命中，所以这是补网不是救火。
#   SELECT slug, name, resident_type, creator_id FROM residents
#    WHERE resident_type <> 'player'
#      AND (creator_id = '00000000-0000-0000-0000-000000000001'
#           OR slug IN ('xiao-yan','steve-jobs','elon-musk','charlie-munger',
#                       'feynman','naval','taleb','paul-graham','zhang-yiming',
#                       'karpathy','ilya-sutskever','mrbeast','trump',
#                       'zhang-xuefeng','isabella','klaus','adam','mei','tamara'))
#      AND slug NOT IN ('lin-wanqiu','zhou-dahe','chen-tiesheng','shen-jingshu',
#                       'gu-mingyuan','su-xiaoman','he-qiaoyun','zhao-qiwen',
#                       'jiang-lin','a-lan','luo-xiaozhou');
# 两份 slug 名单与实现同步，由 test_env_example_consistency.py::
# test_roster_guard_sql_covers_both_deletion_branches 守住（加一位 preset 或多一个
# legacy slug 而没同步这里，当场红）。

# 第一次变更：事实层（镇长/职务/政策/镇库/进行中公投/今天/地点进 prompt）。
# 开闸后读数：curl -s localhost:8000/metrics | grep civic_facts_failopen_total → 应为 0
CIVIC_FACTS_ENABLED=false

# --- P3 开闸硬顺序（七道闸的赋值行由各自 step 已写入本文件，此处只排顺序）---
#  1) WORLD_RELOAD_RESET_PATH_CACHE —— 先让运行中新建的楼当场可达
#  2) LOCATION_SPECIFIC_FIRST_ENABLED —— 真实依赖方是:decide/basic.py 的
#     dining 判定、_maybe_shelter 的 location_is_indoor、location_tracker 首访、
#     location_lore、/exploration/me。**它不是 P1 能力闸的前置**:P1 的两个能力门
#     走 map_data.capability_location_at(自带穿透遮蔽的最小面积匹配),不经
#     get_location_id_at —— 旧文案里那句「必须先于任何依赖 get_location_id_at 的
#     P1 能力闸」是错的,照它排会假报「P1 接线失败」。
#     商队路面语义已由 P3-S8b 解耦(outdoor_container_at),不再受本闸影响,
#     但 **S8b 必须先合入** 再翻本闸。
#     ⚠ 本闸一次性不可逆:翻开当下触发 post_office/theater 的
#     location_first_visit → explorer_* 成就与赛季分,关回去收不回。
#  3) CIVIC_BUILD_SCHEMA_ENABLED + CIVIC_BUILD_VALIDATE_ENABLED —— 校验先于
#     下一次公投建楼生效
#     ⚠ CIVIC_BUILD_VALIDATE_ENABLED 另有一条跨批次前置:库里存量剧院的 bounds
#     今天就是越界的,先翻本闸再重跑剧院 effect 会被自己的校验拒收。正确序是
#     「P3-S13 迁移 068 → P3-S14 CIVIC_AGENDA 坐标字面量同步 → 才翻本闸」,
#     且迁移与开闸**不得同批**(红线:迁移/清库 与 开闸/行为变更不同车)。
#  4) CIVIC_EFFECT_AUDIT_ENABLED / CIVIC_FACTS_PLACES_DYNAMIC_RESERVE(任意序)
#     建议把 CIVIC_EFFECT_AUDIT_ENABLED 排到 3) 之前:两者无代码耦合(审计关着
#     几何校验照样拒收,只是不记账),但校验上线后第一批被拒的公投若没有审计,
#     在库里与「执行时炸了」长得一模一样,事后无从复盘。
#  5) CIVIC_BUILD_OPENING_EVENT_ENABLED —— 须同时开 REALISM_CROWD_ENABLED,
#     否则庆典零位移拉力
#     两份模板对 REALISM_CROWD_ENABLED 取值不同:backend 那份是 true(开发意向),
#     deploy 那份是 false —— **以 deploy 那份为准,生产现在是关的**。
# 公投/Lab 建楼载荷的白名单投影 + type 缺省 + 非法动作码剔除。
# 关(默认) = effect.data 除 slug 外整包落库 = 逐字节旧行为。
# 开 = 未登记键被丢弃并记 warning;capabilities 归一成 dict 后按
#      location_caps.CIVIC_GRANTABLE_CAPABILITIES 白名单过滤。
CIVIC_BUILD_SCHEMA_ENABLED=false
# 建楼落库前的几何校验:outdoor 街区重叠降级为 warning(否则邮局这类合法楼
# 被误杀)、楼压楼仍是 error、bounds/入口须落在 walkable 域 [14,173]x[12,123]、
# 入口须落在 central_plaza 的连通分量上(判据是 get_reachable_tiles,
# 不是会自证的 get_walkable_tiles)。公投是 upsert,同 slug 不算冲突。
# 关(默认) = 只校验 slug 非空 + bounds 存在 = 逐字节旧行为(剧院照样落界外)。
CIVIC_BUILD_VALIDATE_ENABLED=false
CIVIC_FACTS_CACHE_TTL_SECONDS=60.0
# 有界 fail-open 的最大陈旧期：旧快照超龄就不注入，不让居民说出过期的镇长。
CIVIC_FACTS_MAX_STALE_SECONDS=600.0
# 「小镇有哪些地方」名单(PLACES_LIMIT=12)里给公投新建的楼留几个坑。
# 0(默认) = 逐字节旧行为:静态设施在前占满,新楼永远被挤掉。
# 开到 N:动态先占最多 N 个坑,没填满的坑退还给静态(len(places) 与改前恒等);
# 渲染顺序仍是静态在前(prompt 前缀缓存不抖),只有名额分配先给动态。
CIVIC_FACTS_PLACES_DYNAMIC_RESERVE=0
# 公投执行结果写回 options_json[0](_effect_applied / _effect_error)+ 计数器。
# 关(默认) = 失败原因只剩一句中文公告 + 一行 logger.warning,
#            「类型不支持」「执行抛异常」「选址不合规」三者不可区分。
# 开 = 错误分码入库并进 CIVIC_EFFECT_APPLIED 计数器;错误码不出网
#      (script_service.public_option 是白名单投影)。
CIVIC_EFFECT_AUDIT_ENABLED=false
# 新楼落成庆典:一条 type="festival" 的世界事件(天数取 effect.data 的
# opening_event_days,0/缺省/bool = 不开,上限 7 天),与建楼同一次 commit。
# 关(默认) = 不建任何事件。
# ⚠ 开闸硬前置:只有**同时**开 REALISM_CROWD_ENABLED 才有位移拉力 ——
#   crowd_service._EVENT_TYPES_WITH_CROWD 是 ("festival","script") 闭集,
#   x3 抽签偏置由那道闸把关;不开就只有记忆与 prompt 里提一嘴,零人流。
#   本模板原本没有 REALISM_CROWD_ENABLED 赋值行(生产取代码默认 False),
#   故这里显式写出,免得开闸时误以为它已经是开的。
CIVIC_BUILD_OPENING_EVENT_ENABLED=false
REALISM_CROWD_ENABLED=false

# ── 世界重载时的路网缓存失效 (WORLD_RELOAD_*) ──────────────────────────────
# reload_world 顺带清 pathfinder 路径缓存与 caravan 路网 lru_cache。
# 关(默认) = 运行中新建的楼要等进程重启才走得到(find_path 的
#            to_tile not in walkable 直接 return None)。
# 触发频率(别按「每 tick」估):reload_world 只有这些调用点 —— 进程启动
#   (main.py:87 / agent/main.py:59 / lab/main.py:421)、lab apply/revert
#   (apply.py:210,284)、proposal apply/revert(proposal_service.py:305,370)、
#   公投落库(civic_service.py:932),外加每进程一个 world_reload_subscriber
#   (apply.py:338) 把上述任一次广播成「每进程各重算一次」。
#   **agent tick 不调它**,不在 NPC 热路径上。
# 单次代价(本机实测):tilemap 6.1MB 解析+全量重扫 18.35ms + BFS 4.28ms,
#   下一次商队路网重建再 38.42ms —— 合计约 61ms 同步阻塞/进程/次,
#   日常量级是「结票/审批」那种个位数次/天。因此**不加节流器**:
#   加了反而让「新楼何时可达」变得不可预测。清完是惰性重建,重算落在清完后
#   第一个碰它的协程里。
WORLD_RELOAD_RESET_PATH_CACHE=false

# 第二次变更：镇务记忆广播（收件人 = 14 位自治居民 = 11 npc + 3 UGC resident，
# player 不收）。开闸后等真实镇务事件，不为验证造假公告。
# 可检索性硬门（**只量结果档**，拿全集会假红）。
# 判据是「排在它前面的记忆不足一池」，**不是**「importance 高于第 30 名」：候选池
# 的排序是 `ORDER BY importance DESC, created_at DESC LIMIT 30`
# （app/memory/service.py:308-320）——importance 并列时新记忆靠 created_at 排在
# 前面，所以**等于**第 30 名照样进得去。写成严格「高于」会把一条实际已进池的结果
# 档判成不达标，运维照着它把闸关回去 = 假红退闸。候选池深度 = 30
# （= max(max_events*3, 30)，app/memory/service.py:364，max_events 默认 10）。
# 逐条查，每一行的 ahead_of_it 必须 < 30：
#   select m.resident_id, m.importance,
#          (select count(*) from memories x
#            where x.resident_id = m.resident_id
#              and x.type = 'event'
#              and x.archived_at is null
#              and x.importance > m.importance) as ahead_of_it
#     from memories m
#    where m.source = 'civic'
#      and m.metadata_json->>'civic_event' like 'civic:poll_result:%'
#    order by ahead_of_it desc limit 20;
# 为什么不能用 source='civic' 全集：征询档（CIVIC_MEMORY_NOTICE_IMPORTANCE=0.6，
# = poll_open 与无稳定键的 post 公告）本来就**不打算**进候选池，它的 ahead_of_it
# 必然远超一池，混进来必然假红。S11 实测：结果档归一后落 0.9583~0.947，
# poll_open 档 0.05 以下，根本进不了候选池。
# 想一眼看两档（is_notice=true 即 0.6 档；false 含 poll_result 与 civic_standing
# 这两条走 0.9 缺省档的路径）：
#   select metadata_json->>'civic_event' ~ '^civic:(poll_open|post):' as is_notice,
#          count(*), min(importance), max(importance)
#     from memories where source='civic' group by 1 order by 1;
CIVIC_MEMORY_BROADCAST_ENABLED=false
CIVIC_MEMORY_IMPORTANCE=0.9
CIVIC_MEMORY_NOTICE_IMPORTANCE=0.6

# ── world_event 记忆分档（REALISM_EVENT_MEMORY_*）──────────────────────────
# 零新表零迁移。默认关 → write_collective_memories 与现状逐字节一致（同样的
# importance、同样的 metadata、同样的返回值），开闸是单独一次部署变更。
#
# ⚠️ 这两个键是**手工**同步到本文件的：上面那条 parity 只覆盖 CIVIC_/REP_/
# POLIS_OFFICE_ 三个前缀（backend/tests/test_env_example_consistency.py 的
# GOVERNANCE_PREFIXES），REALISM_ 不在其中。本批另有
# test_event_memory_tier_knobs_exist_in_deploy_env_example_too 单独守着这两个键。
#
# 缺陷：write_collective_memories 直写 Memory(importance=0.5/0.6)，绕过
# MemoryService.add_memory 也就绕过了分位归一；而候选池按 importance DESC 静态截
# 前 30，生产 top-30 第 30 名都在 0.95-1.0 —— 1311 条 world_event 记忆一条都进不
# 去。修法是**分档**不是整体抬高：其中 1253 条（96%）是天气，抬上去等于拿「今天
# 多云」灌满那 30 个坑，比现状更糟。
#   琐事档（天气 / 集市日节庆）→ 仍旧直写，不参与候选池竞争；
#   实质档（非集市日的节庆 / news / script）→ 走 add_memory 参与归一。
# 集市日归琐事：它每周复现（MARKET_DAY_WEEKDAY），且 NPC 已经从事实层
# （town_facts 的 today.is_market_day）知道今天是不是集市日，不必再占一个坑。
#
# ⚠️ 前置：本闸依赖 REALISM_ENABLED=true。归一化只在总闸下生效
# （memory/service.py 的 add_memory 只在 realism_enabled 时才归一并写
# raw_importance）。总闸关时本闸等于 no-op，且下面那条核验 SQL 会返回 0 行 ——
# 那是「总闸没开」不是「分档没生效」，别误判成回滚理由。
#
# ⚠️ 退闸判据一：核验 SQL 里任一行 ahead_of_it >= 30，说明 raw 0.9 在该居民的
# 池形状下不够（归一上界是 (n-1+0.5)/n，窗口 max=0.9 时封顶 0.995，池底为 1.0
# 的居民仍进不去）。这时要另开一次独立变更把 REALISM_EVENT_MEMORY_IMPORTANCE
# 抬到 1.0，不要靠再等一次事件。
#
# ⚠️ 退闸判据二（结构性，必须每 2 周查一次）：实质档记忆落 0.995 且**永不淘汰**
# （evict 的门槛是 REALISM_EVICT_IMPORTANCE_FLOOR=0.35 + idle 90 天，够不着
# 0.99），而候选池是纯 importance DESC 静态截断 —— 它们是永久住户。12 周模拟
# （生产形状：天气 5-6/天、实质事件约 1.6 条/人/周）显示 world_event 占池
# day28 7/30 → day56 14/30 → day84 21/30，个人记忆掉到 9/30。查：
#   select resident_id,
#          count(*) filter (where source in ('civic','world_event')) as public,
#          count(*) as pool
#     from (select * from memories where type='event' and archived_at is null
#            order by importance desc, created_at desc limit 30) t
#    group by 1;
# public/pool 一旦 >= 2/3 立即退闸。**不要靠继续抬 raw 解决** —— 真正的病是
# 候选池没有衰减/配额，公共通道只是把它照出来了。
#
# ⚠️⚠️ **本闸已被 REALISM_POOL_WORLD_EVENT_RESERVE 那条专用道取代，保持永久关闭。**
# 设计反转（2026-08-10）：有了保留位之后，「分档抬 importance」这套机制既不必要也
# 不该用 —— 抬到 0.99 的实质事件会**同时**挤占个人臂（就是上面那条 12 周饱和：
# day28 7/30 → day84 21/30）**又**吃专用道坑位，双重占坑；而专用道本身就保证**进
# 候选池**，不需要靠抬 importance 去挤。所以现在的方向是反过来的：实质世界事件**保持
# 低 importance**（与天气同档，永不挤占个人臂），完全靠专用道拿到候选池里的保证坑位。
# 写入侧的档位标记 metadata_json.tier 与本闸**无关**（闸开闸关都写、同一事件取值
# 相同），专用道认的是那个标记，不是这个闸。
REALISM_EVENT_MEMORY_TIERED=false
# 实质档的 raw importance。**落库的是分位数，不是这个值本身**：生产归一化窗口
# （最近 100 条）的 raw 分布 p50 0.47 / p90 0.70 / p95 0.70 / max 0.90，0.9 归一后
# 落 0.95 以上，与 civic 结果档同一档位。
# 开闸后等下一次真实的非琐事事件（不为验证造假事件），按 CIVIC_MEMORY_ 段同一条
# 可检索性判据核验（ahead_of_it < 30，不是「高于第 30 名」）：
#   select m.resident_id, m.importance, m.metadata_json->>'raw_importance' as raw,
#          (select count(*) from memories x
#            where x.resident_id = m.resident_id
#              and x.type = 'event'
#              and x.archived_at is null
#              and x.importance > m.importance) as ahead_of_it
#     from memories m
#    where m.source = 'world_event'
#      and m.metadata_json->>'raw_importance' is not null
#    order by m.created_at desc limit 20;
# raw 非空 = 确实走了 add_memory（直写那条路不写这个键），这一列就是分档生效的凭据。
REALISM_EVENT_MEMORY_IMPORTANCE=0.9

# ── 候选池内的镇务保留位（REALISM_POOL_CIVIC_RESERVE）──────────────────────
# 零新表零迁移。默认 0 = **逐字节**旧行为（同样的 SQL、同样的返回序列），开闸是
# 单独一次部署变更。一个数同时表达「开没开」与「几个坑」。
#
# ⚠️ 这个键也是**手工**同步到本文件的：上面那条 parity 只覆盖 CIVIC_/REP_/
# POLIS_OFFICE_ 三个前缀（backend/tests/test_env_example_consistency.py 的
# GOVERNANCE_PREFIXES），REALISM_ 不在其中。本批另有
# test_pool_reserved_slot_knob_exists_in_deploy_env_example_too 单独守着它。
#
# 缺陷：候选池是 `ORDER BY importance DESC, created_at DESC LIMIT 30`，相关度那
# 0.45 的权重是**截断之后**才参与的 —— 它根本不参与入池。2026-08-10 生产只读
# 对拍：
#   居民            活跃 event   落库 1.0 条数   池底(第 30 名)   镇务记忆进得去?
#   jiang-lin        8355          36            1.0             否（第 31 名）
#   zhao-qiwen       8042          44            1.0             否
#   chen-tiesheng    6525          27            0.995           否
#   chen-yu          1946           7            0.985           是
# 镇务结果档 raw 0.9 归一后是 0.99 —— **差 0.01 就永远进不去，且病症逐人**。
#
# 修法是池内保留位，不是扩池（扩池会稀释 public/pool 那条硬门的分母）：
#   pool(cap) = 专用道(最多 N 条 civic:poll_result，按 created_at DESC)
#             ∪ 个人臂(cap − 专用道**实际拿到**的条数)
# 没填满的坑**退还**给个人臂 → len(pool) 恒等于 min(cap, 该居民活跃 event 总数)，
# 与改前逐字相同；专用道成员从个人臂排除，不双份占坑。
#
# 口径（已拍板）：只收 metadata_json->>'civic_event' LIKE 'civic:poll_result:%'。
#   - 征询档（civic:poll_open:）不进 —— 保持 M3 分档，且「镇上正在议什么」已由
#     事实层的 town_facts.open_polls 提供，不必再占记忆坑；
#   - world_event 不进 —— 公共臂 top-41 全是 importance=0.5 的天气，10 个公共坑
#     会 100% 被天气占。
#
# ⚠️ 前置：本闸只在候选池真有 30 个坑时生效。embedding 拿不到时走 fail-open
# （memory/service.py 的 _search_events，cap=limit=10），那条路上池只有 10 条且
# 没有相关度可言，在 10 个坑里塞 2 条盲选公告 = 20% 的输出被污染 —— 所以代码里
# 定死 effective_reserve = 0 if cap < 30 else RESERVE。
#
# ⚠️ 开闸后的核验（等下一次真实结票，不为验证造假 poll）：按 CIVIC_MEMORY_ 段
# 同一条可检索性判据查 ahead_of_it，并对 **jiang-lin / zhao-qiwen** 单独验 ——
# 他们的 top-30 里必须出现那条 poll_result 记忆（改前是 0/4 位居民进得去）：
#   select m.resident_id, m.importance,
#          (select count(*) from memories x
#            where x.resident_id = m.resident_id and x.type = 'event'
#              and x.archived_at is null
#              and x.importance > m.importance) as ahead_of_it
#     from memories m
#    where m.source = 'civic'
#      and m.metadata_json->>'civic_event' like 'civic:poll_result:%'
#    order by m.created_at desc limit 20;
# ahead_of_it >= 30 的那些人正是保留位要救的人 —— 开闸后他们照样能读到那条记忆，
# 因为保留位绕开了 importance 排序，不是把 importance 抬上去。
#
# ⚠️ 退闸判据：public/pool（见上一段那条 SQL）一旦 >= 2/3 立即退闸。保留位吃的是
# 个人臂的坑，N 越大个人记忆越少 —— 2 是拍板值，不要随手加。
REALISM_POOL_CIVIC_RESERVE=0

# ── 候选池内的 world_event 专用道（REALISM_POOL_WORLD_EVENT_RESERVE）──────────
# 第二条道。零新表零迁移，默认 0 = **逐字节**等于上面那条道单独存在时的行为
# （同样的 SQL、同样的返回序列），开闸是单独一次部署变更。
#
# ⚠️ 这个键同样是**手工**同步到本文件的（REALISM_ 不在 GOVERNANCE_PREFIXES 里），
# 由 backend/tests/test_env_example_consistency.py 的 REALISM_POOL_ 前缀那条守着。
#
# 为什么不能按 source 开道 —— 2026-08-10 生产只读实测：
#   source='world_event' 且带 raw_importance 的记忆   0 / 1380
#   近 3 天 world_event 记忆构成                       weather 261 / festival 17
#   公共臂 top-41（保留位那批的对拍）                  全是 importance=0.5 的天气
# 按 source + created_at DESC 开道 = **94% 抓到天气**，10 个公共坑 100% 被「今天
# 多云」占满，而天气真的挤进过「现在镇长是谁」的输出。
#
# 所以这条道认的是**写入侧盖的显式档位标记**：
#   source='world_event' AND metadata_json->>'tier' = 'substantive'
# 口径沿用 _is_trivial_event（天气、以及 market_day 那一档节庆 = trivia，其余 =
# substantive），只是把结论落成一个可查询的键。标记与 REALISM_EVENT_MEMORY_TIERED
# **无关**：那个闸开或关，两条写入路径都写、同一事件取值相同。
#
# ⚠️ 存量 1380 条没有这个键 → 专用道对它们查不到。这是**预期**的（它们本来也都是
# 天气和几条早已过时的节庆），**不回填**（数据变更与开闸不同车，07-25 事故就在这
# 个窗口里）。开闸后要等**下一次真实的实质事件**（公开课 / 节庆）才看得到效果。
#
# 结构与 civic 道同构：pool(cap) = civic道(≤N1) ∪ world_event道(≤N2) ∪ 个人臂
# （cap − 两道**实拿**之和）。没填满的坑退还给个人臂 → len(pool) 恒等于
# min(cap, 该居民活跃 event 总数)；fail-open（cap<30，embedding 拿不到时）两条道
# 都自动失效。
#
# 预算：2 + 1 → public 3/30 = 10%，个人臂 27/30 —— 离 public/pool < 2/3 与
# personal > 1/3 两条硬门都还有大余量（饱和史下实测，见
# backend/tests/test_civic_prompt_budget.py）。
#
# 建议开闸值 **1**：实质事件约 1.6 条/人/周，1 个坑约等于「记得最近那件事」；
# 2 个坑会让两周前的节庆压住这周的。
#
# ⚠️ 这条道保证的是**进候选池**，不是「保证被检索到」。池是 30 条，而交给 prompt
# 的是打分后的 **top-10**（0.45·相关度 + 0.30·recency + 0.25·importance）——
# 进池只是参赛资格。所以实质事件必须**带 embedding 落库**（写入侧
# world_event_service._embed_or_none）：没有向量时 cos 恒为 0，得分上界只剩
# 0.30×1 + 0.25×0.5 = 0.425，而饱和居民第 10 名个人记忆实测 0.4562 —— 进了池，
# 必被 top-10 截断。补上向量之后它仍要 cos 打赢第 10 名才进 prompt（切题的问句
# 过得去、不切题的过不去），这**是想要的行为**。
#
# ⚠️ 开闸后的核验（等下一次真实实质事件，不为验证造假事件）：
# ① 落库形状——tier 盖上了、向量不是 NULL、排在它前面的有多少条：
#   select m.resident_id, m.importance, m.metadata_json->>'tier' as tier,
#          (m.embedding is not null) as has_vec,
#          (select count(*) from memories x
#            where x.resident_id = m.resident_id and x.type = 'event'
#              and x.archived_at is null
#              and x.importance > m.importance) as ahead_of_it
#     from memories m
#    where m.source = 'world_event'
#      and m.metadata_json->>'tier' = 'substantive'
#    order by m.created_at desc limit 20;
# ahead_of_it >= 30 的那些人正是这条道要救的人：开闸后他们照样**进得了池**，因为
# 专用道绕开了 importance 排序，不是把 importance 抬上去。has_vec 若为 false，
# 这条道就白开了——它送进池的是一条自弃 45% 权重的记忆。
# ② 真的读得到吗——**必须走 retrieve_context 的返回值**，拿一句针对该事件的问句
# （如「镇上最近要修剧院的事你听说了吗」）问那位居民，看返回的 10 条里有没有它。
# 只查「进没进 top-30」会拿到假阳性：进池与进 prompt 是两件事。
#
# ⚠️ 退闸判据：public/pool（civic 段那条 SQL）一旦 >= 2/3 立即退闸。
REALISM_POOL_WORLD_EVENT_RESERVE=0

# ── 计划阶段里的「镇上的事」（REALISM_PLAN_PUBLIC_MEMORIES）──────────────────
# 零新表零迁移，默认 0 = 计划 prompt **逐字节**等于改前（同样的模板、同样的字符）。
# 开闸是单独一次部署变更。
#
# ⚠️ 这个键同样是**手工**同步到本文件的（REALISM_ 不在 GOVERNANCE_PREFIXES 里，
# 也不在上面那条 parity 的 REALISM_POOL_ 前缀内），由
# backend/tests/test_env_example_consistency.py 的 REALISM_PLAN_ 前缀那条守着。
#
# 治的病（2026-08-10 生产只读实测，app/agent/phases/plan/basic.py）：
#   居民            那 20 条覆盖的时间   importance>0.5 后剩   其中 world_event
#   gu-mingyuan     20 分钟              18                    0
#   he-qiaoyun      30 分钟              7                     0
#   （六位居民全测，world_event 计数**全是 0**）
# 计划阶段读的是 get_memories(type='event', limit=20) = ORDER BY created_at DESC。
# 每人每天写 480-545 条 event 记忆 → 20 条只覆盖 **20-30 分钟**；而实质世界事件约
# 1.6 条/人/周、镇务结果更稀疏 —— 落进这个窗口的概率约等于 0。
# 所以「NPC 计划自己一天时不知道镇上出了什么事」的根因是**时间窗口**。
#
# ⚠️ 不是阈值问题：那 20 条里 7-18 条都过得了 importance>0.5，它筛掉的是天气
# （恒 0.5）与低价值 agent_action，做的正是该做的事。改成 >= 0.5 会把天气放进来。
# ⚠️ 也不是「把 limit 调大」：要覆盖一周就是 ~3500 条一次全表读，而那 20 分钟窗口
# 对「个人近况」本来就是对的口径。两件事口径不同，不该用同一个 limit 表达。
#
# 做法：复用候选池那两条道的**取数判据**（不是取候选池本身，计划阶段不走
# retrieve_context —— 没有 query text，相关度那 0.45 分在这里无意义）：
#   镇务   metadata_json->>'civic_event' LIKE 'civic:poll_result:%'
#   世界   source='world_event' AND metadata_json->>'tier'='substantive'
# 各取最近的，交替取到 N 条上限，与「个人近况」并列渲染成 prompt 里的一段。
# N=0 时**整段不渲染**（连标题都不出现）；一条也取不到时同样不渲染空标题。
#
# 与 REALISM_POOL_* 两条道相互独立：那两条管检索候选池，这条管计划 prompt。
# 开哪条都不依赖另一条（本键为 0 时计划阶段一条公共记忆都不读）。
#
# 建议开闸值 **2**：一条镇务 + 一条世界事件的量级。个人近况最多 5 条不受影响
# （公共记忆是**新增**的一段，不占那 5 条）。
#
# ⚠️ 存量不回填：世界事件专用道认的 tier 标记是 W1 之后才写的，08-10 之前的
# 1380 条没有这个键 —— 开闸后要等**下一次真实的实质事件**（公开课/节庆/结票）
# 才看得到效果（数据变更与开闸不同车，07-25 事故就在这个窗口里）。
#
# ⚠️ 开闸后的核验：抓一次真实的 plan prompt（agent-worker 日志或一次性只读脚本），
# 确认「镇上最近发生的事」那一段真的在 user prompt 文本里。查「记忆读到了没」
# 会拿到假阳性 —— 进容器与进 prompt 是两件事（第 3 段的教训）。
REALISM_PLAN_PUBLIC_MEMORIES=0

# ── 拟真修复分批闸（默认关闭；先 shadow/单独开闸）────────────────────────────
# 连续行程只让已启动的计划移动跨 tick 完成；硬需求/恶劣天气仍可中断。
REALISM_PLAN_CONTINUITY_ENABLED=false
REALISM_PLAN_CONTINUATION_MAX_STEPS=32
REALISM_SOCIAL_INTERRUPT_NEED_MAX=0.35
REALISM_SOCIAL_INTERRUPT_MAX_IMPORTANCE=4
REALISM_NOTABLE_EVENT_MAX_WORLD_MINUTES=60
# 人格叙事冷却按世界时；安全预算仍按真实 rolling 7/30 天。
REALISM_PERSONALITY_PACING_ENABLED=false
REALISM_DRIFT_MIN_WORLD_HOURS=72
# 给低 importance、带 event_id 的最新传闻留一条独立候选道。
REALISM_GOSSIP_EVENT_LANE_ENABLED=false

# ── P1 地点能力声明（LOCATION_CAPABILITIES_ENABLED）────────────────────────────
# 这个键是手工同步到本文件的（LOCATION_ 既不在 GOVERNANCE_PREFIXES 里，也不在
# REALISM_POOL_ / REALISM_PLAN_ / REALISM_EVENT_MEMORY_ 任何一条现成 parity 的前缀
# 内，四条 parity 全都扫不到它），由 backend/tests/test_env_example_consistency.py
# 的 LOCATION_ 前缀那条守着。
#
# 关（默认）= 逐字节旧行为，三处：
#   1 RESEARCH 的地点门比字面量 experiment_building（app/agent/actions.py:143）
#   2 EAT 的地点门走 _DINING_LOCATIONS={cafe,tavern} 白名单（map_data.py:289）
#   3 餐费分账按 cafe_host / tavern_hub 硬编码（execute/basic.py:72）
# 开 = 这三处改读地点自己的 capabilities 声明。
#
# 声明已随代码落地（cafe / tavern / experiment_building / market_hall 四条静态条目），
# 开闸不带任何数据变更——存量两栋公投楼（post_office / theater）在 P1 不需要任何
# 声明：它们今天既非 dining 也非 research，缺键即缺省安全，开闸后与今天逐位相同。
#
# 与 REALISM_ENABLED 正交：EAT 门本来就在 realism 内层，本闸是内层再套一层。
# REALISM_ENABLED=false 时开本闸不会凭空产生 EAT。
#
# 开闸硬顺序（写死，别凭记忆）：本闸自身无前置，也**不是** P2 邮局侧（DUTY_VENUE）
# 的前置——这句话曾经反着写过，是错的。P2 的接线走 map_data.location_capabilities /
# capability_location_at / capability_locations，这三个都是**不读闸的纯查询**（它们
# 绕开了 outdoor 街区对两栋公投楼的坐标遮蔽：get_location_id_at(46,103) 实测返
# south_quarter），本闸关着它们照常返回能力与地点。本闸只管两件事：location_category
# 的能力派生层，以及 RESEARCH/EAT 两个门（外加 nearest_capability_location 多一层
# 可达性过滤）。两闸正交，谁先谁后都行。
# P2 各闸真正的硬前置在**数据侧**——见下面 DUTY_VENUE_ENABLED 那段。
#
# 开闸后另有两处真实行为面（不是纯等价重构，按「有资金流向 / 目标选择变更」对待）：
#   a 餐费：站在 dining 地点但没有可转账店主时（店主职位空缺 / 店主吃自己店 /
#     第三家餐馆漏写 host_duty），餐费从「销毁」改为进镇库（treasury_debit_pending
#     + tax_pending，reason=meal:no_host_duty）。需 TOWN_TREASURY_ENABLED 同时开才
#     生效；本闸单开时这条不动。
#   b 去哪吃：nearest_dining_location 改走能力反查，候选入口须真正可达
#     （pathfinder.get_reachable_tiles），越界落库的存量楼不再会被选成吃饭目标。
#     注意可达集是进程级缓存：运行期新增的动态楼在 WORLD_RELOAD_RESET_PATH_CACHE
#     开闸前会被这层过滤挡掉，表现为「新楼建好了但没人去」。
#
# 开闸后的核验：抓一次 agent-worker 的 agent.events，确认咖啡馆 / 酒馆里的居民仍能
# 拿到 EAT、实验楼里的研究员仍能拿到 RESEARCH（等价性由
# backend/tests/test_capability_action_gates.py 的 34 条穷举对拍守着，开闸前先在本机
# 把它跑绿）。
LOCATION_CAPABILITIES_ENABLED=false

# ── P2 营生场所（DUTY_VENUE_ENABLED）──────────────────────────────────────────
# 这个键是手工同步到本文件的（DUTY_VENUE_ 既不在 GOVERNANCE_PREFIXES 里，也不在
# REALISM_POOL_ / REALISM_PLAN_ / REALISM_EVENT_MEMORY_ / LOCATION_ 任何一条现成
# parity 的前缀内，五条 parity 全都扫不到它；TOWN_DUTY_FUNDING_ENABLED 是 TOWN_
# 前缀，不沾边），由 backend/tests/test_env_example_consistency.py 的 DUTY_VENUE_
# 前缀那条守着。
#
# 关（默认）= 逐字节旧行为：邮差 WORK 时照旧投递、照旧写同一条记忆文本、metadata
# 不写、feed payload 不多键；decide 的 _maybe_duty_venue 第一行即返回，决策排序与
# 今天等价。
# 开 = 两件事：
#   1 _work_postman 解析「投递现场」（站在提供 postal 能力的地点里），给记忆写
#     metadata['duty'] = {key, at, delivered}——两个分支都写（at 为 null 表示不在
#     现场），这是 M2 口径的唯一数据源，只在现场写会让分母塌成分子；
#   2 decide 新增 _maybe_duty_venue：营生有现场声明、今天还没上工（读的就是
#     on_work 写的 sv:duty_work:{id}）、人不在现场时，把这一 tick 定成
#     VISIT_DISTRICT 去现场（零 LLM）。插在 crowd 之后、计划跳过之前。
#
# 回滚保证（写死，别凭记忆）：胶囊的封存与投递**都不要求在邮局**。
# deliver_due_capsules 的 WHERE 不带任何 location 条件，nightly_cron 的无条件兜底
# 原样保留——邮局是「投递现场」不是「准入条件」。所以任何时刻把本闸翻回 false 都
# 不会让胶囊积压。护栏 SQL（恒为 0，违反即回滚）：
#   select count(*) from time_capsules
#    where status='sealed' and deliver_on < current_date - 1;
#
# 开闸硬顺序（写死，别凭记忆）：
#   1 代码侧——P1 的 location_caps / capability_location_at /
#     nearest_capability_location 必须已合入，且 CAPABILITIES 里登记了 postal
#     （civic_grantable=true）。
#     本闸**不依赖** LOCATION_CAPABILITIES_ENABLED：location_capabilities 与
#     capability_location_at 都是不读闸的纯查询，那道闸只管 location_category 的
#     能力派生层与 RESEARCH/EAT 两个门。两闸正交，谁先谁后都行。
#   2 数据侧（真正的硬前置）——生产 dynamic_locations 里 post_office 那行的
#     data_json 必须已带上 capabilities={"postal":{}}。存量行是公投建的，没有这个
#     键；回填是纯数据变更，**必须独立批次**（迁移/数据变更与开闸不同车，07-25
#     事故红线）。正确顺序：先部署代码（闸关）→ 单独一批回填 → 再单独一次开闸。
#     没回填就开闸不会出事，只是现场分支恒不命中、M2 的 on_site 恒为 0，与今天等价。
#
# 开闸后的核验（按天看，别看容器日志——它会轮转）：
#   M1 邮差真的去了：
#     select r.slug,
#            count(*) filter (where m.metadata_json->'move'->>'arrived'='true') arrivals,
#            count(*) attempts
#       from memories m join residents r on r.id = m.resident_id
#      where m.metadata_json->'move'->>'target' = 'post_office'
#        and m.created_at >= now() - interval '14 days'
#      group by 1 order by 2 desc;
#   M2 投递真的发生在邮局（on_site / work_runs ≥ 0.5，且 sum(delivered) 不低于
#   开闸前同期）：
#     select date_trunc('day', m.created_at) d,
#            sum((m.metadata_json->'duty'->>'delivered')::int) delivered,
#            count(*) filter (where m.metadata_json->'duty'->>'at'='post_office') on_site,
#            count(*) work_runs
#       from memories m
#      where m.metadata_json->'duty'->>'key' = 'postman'
#        and m.created_at >= now() - interval '14 days'
#      group by 1 order by 1;
#   memories.metadata_json 是 sa.JSON（PG 上是 json 不是 jsonb）：-> / ->> 可用，
#   @> 与 GIN 索引不可用，所以上面两条都必须带 created_at 时间窗。
DUTY_VENUE_ENABLED=false

# ── P2 剧院/舞台事件（STAGE_EVENT_ENABLED）─────────────────────────────────────
# 关（默认）= 逐字节旧行为：辩论生命周期一步不变、不建任何舞台世界事件、讲师的
# 公开课仍然是 type="news"。
# 开 = 两件事：
#   1 辩论开票的同一刻，在声明了 stage 能力的地点挂一条 type="script" 的 WorldEvent
#     （ends_at = 投票窗口 DEBATE_VOTE_WINDOW_MIN）；
#   2 讲师公开课的事件 type 从 "news" 改成 "script"。
#
# 为什么是 "script"：crowd_service._EVENT_TYPES_WITH_CROWD = ("festival", "script")，
# "news" 不在里面 —— 所以 active_event_location 永远看不到公开课，
# festival_draw_target 的 ×REALISM_FESTIVAL_WEIGHT 人流拉力对公开课**一次都没生效
# 过**。改 type 是零改动接上那条已经过生产验证的拉力（集市日走的就是它）。
# 不把 "news" 加进那个元组：那会让 NEWS_POOL 的四条随机新闻也长出人流语义。
#
# 不改变的事：零新增 ActionType；零新增经济出口——观众收益只写记忆/心情/social/
# 关系，debate settle 的 5% burn 分账是唯一真金出口，不得双花。
#
# 开闸硬前置（写死，别凭记忆）：
#   1 代码侧——P1 的 location_caps / has_capability / capability_locations 必须已
#     合入，且 CAPABILITIES 里登记了 stage（civic_grantable=true）。
#     本闸**不**依赖 LOCATION_CAPABILITIES_ENABLED：location_capabilities 与
#     has_capability 都是不读闸的纯查询。
#   2 依赖 REALISM_CROWD_ENABLED=true —— ×3 人流拉力由它把关
#     （decide/basic.py 的 _maybe_crowd_draw）。它关着的话本闸只剩 prompt 里多一条
#     事件描述，人流一个不动。
#   3 数据侧——生产 dynamic_locations 里 theater 那行的 data_json 必须已带上
#     capabilities={"stage":{}}。存量行是公投建的，没有这个键；回填是纯数据变更，
#     **必须独立批次**。没回填就开闸不会出事，只是永远解析不到场地、不建事件，
#     与今天等价。
# 护栏 SQL（恒为 0，违反即回滚）：
#   select count(*) from debates
#    where status <> 'settled' and starts_at < now() - interval '2 days';
STAGE_EVENT_ENABLED=false

# ── P2 剧院人流（STAGE_EVENT_CROWD_ENABLED）─────────────────────────────────
# 这个键**必须**手工同步到本文件：STAGE_ 既不在 GOVERNANCE_PREFIXES
# （CIVIC_/REP_/POLIS_OFFICE_，tests/test_env_example_consistency.py:183）里，也不在
# REALISM_POOL_ / REALISM_PLAN_ / REALISM_EVENT_MEMORY_ / LOCATION_ / DUTY_VENUE_
# 任何一条现成 parity 的前缀内——漏写时那些 parity 全都扫不到它，而「扫不到」的表现
# 和「模板里根本没有这个键」一模一样。由 backend/tests/test_stage_event_crowd_decide.py
# 的 test_flag_is_documented_as_false_in_both_env_templates 按键名兜底守着。
#
# 关（默认）= decide 零新分支、零额外查询，与今天逐字节等价。
# 开 = 演出期间按 sha256 稳定排序挑至多 6 名清醒自治居民去那栋楼（VISIT_DISTRICT，
# 零 LLM）。治的是「剧院 15 天 0 到访 0 人」，做法是把人送到场，而不是放宽
# actions.py 的 CHAT_RESIDENT 判据（放宽会让 LLM 在空场瞎编对话对象，白花钱且吃掉
# 日行动 cap）。
#
# 开闸硬顺序：①P1 的 location_caps 登记了 stage；②真的有演出（STAGE_EVENT_ENABLED
# 开、辩论/公开课建出 type="script" 且 location_id=theater 的 world_event）；
# ③生产 dynamic_locations 里 theater 那行的 data_json 已回填 capabilities={"stage":{}}
# ——回填是纯数据变更，必须独立批次（迁移/数据变更与开闸不同车）。三条缺任一，本闸
# 开着也只是 inert，与今天等价。
# 与 REALISM_CROWD_ENABLED 正交，互不为前置。
STAGE_EVENT_CROWD_ENABLED=false
# 坐标反查按「具体性」优先(非 outdoor > 面积小)。关(默认) = 首命中 = 插入序,
# 即邮局被 south_quarter、剧院被 east_gardens 遮蔽的今天。
# 依赖方(真实清单):decide/basic.py 的 dining 判定、_maybe_shelter 的
#   location_is_indoor、location_tracker 首访、location_lore、/exploration/me。
# ⚠ 一次性不可逆:翻开的当下 post_office/theater 的 tile 首次解析成新 slug,
#   location_tracker 会 emit location_first_visit,下挂 explorer_* 成就与赛季分,
#   闸翻回去也收不回。开闸前先跑影响面盘点 SQL 并写进 handoff。
LOCATION_SPECIFIC_FIRST_ENABLED=false
