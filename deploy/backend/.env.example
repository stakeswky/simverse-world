LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# SearXNG (research)
SEARXNG_URL=http://localhost:58080

# Memory embedding compensation queue. Canary at 100 rows / 10 minutes;
# observe provider failures, round duration and remaining backlog for >=1h
# before raising BATCH_SIZE to 400.
EMBEDDING_BACKFILL_BATCH_SIZE=100
EMBEDDING_BACKFILL_INTERVAL_SECONDS=600
EMBEDDING_BACKFILL_REQUEST_SIZE=50

# Portrait generation (Gemini via proxy)
